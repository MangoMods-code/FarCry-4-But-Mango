+// MARK: - Mango Port: keep this iPhone's saves
+
+/// Per game: when Steam Cloud and this iPhone have different saves, this iPhone's win without
+/// asking (SteamOwnedLibrary.syncCloud), as Keep this device's saves would. For games played only
+/// here, where Valve's client in a session can leave the cloud a step behind the last save.
+enum MangoCloudKeep {
+    private static let key = "mango.cloudKeepDevice"
+    static func isOn(_ appID: Int) -> Bool { (UserDefaults.standard.array(forKey: key) as? [Int] ?? []).contains(appID) }
+    static func set(_ appID: Int, _ on: Bool) {
+        var ids = Set(UserDefaults.standard.array(forKey: key) as? [Int] ?? [])
+        if on { ids.insert(appID) } else { ids.remove(appID) }
+        UserDefaults.standard.set(ids.sorted(), forKey: key)
+        LogStore.shared.log("[mango-cloud] app=\(appID) keep-device=\(on ? 1 : 0)")
+    }
+}
+
+struct MangoCloudKeepSection: View {
+    let appID: Int
+    @State private var on: Bool
+    @ObservedObject private var steam = SteamOwnedLibrary.shared
+
+    init(appID: Int) {
+        self.appID = appID
+        _on = State(initialValue: MangoCloudKeep.isOn(appID))
+    }
+
+    var body: some View {
+        Section {
+            Toggle("Always keep this iPhone's saves", isOn: $on)
+                .tint(MangoTheme.mango)
+                .onChange(of: on) { _, value in
+                    MangoCloudKeep.set(appID, value)
+                    if value { Task { await steam.resolveCloud(appID, useCloud: false) } }
+                }
+        } footer: {
+            Text("For games you only play on this iPhone. When saves differ, this iPhone's are kept and go up to Steam Cloud without asking; the cloud's copies are backed up first, in Files › Mango Port › Steam Cloud Backups.")
+        }
+    }
+}
+
+// MARK: - Mango Port: time played in Mango Port
+
+/// Minutes each game has run in Mango Port, counted while it is the session's game (checked every
+/// 30 seconds, so an app that is closed suddenly loses less than that). Steam games are counted by
+/// App ID ("steam:<id>"), other games by their library entry.
+@MainActor final class MangoPlaytime: ObservableObject {
+    static let shared = MangoPlaytime()
+    @Published private(set) var seconds: [String: Int]
+    private static let storeKey = "mango.playtime"
+    private static let step = 30
+    private var timer: Timer?
+
+    init() {
+        seconds = UserDefaults.standard.dictionary(forKey: Self.storeKey) as? [String: Int] ?? [:]
+    }
+
+    nonisolated static func key(_ entry: LibraryEntry) -> String {
+        entry.steamAppID.map { "steam:\($0)" } ?? "entry:\(entry.id.uuidString)"
+    }
+
+    func start() {
+        guard timer == nil else { return }
+        timer = Timer.scheduledTimer(withTimeInterval: TimeInterval(Self.step), repeats: true) { _ in
+            MainActor.assumeIsolated { MangoPlaytime.shared.tick() }
+        }
+    }
+
+    private func tick() {
+        let library = LibraryModel.shared
+        guard library.current != nil, let entry = library.activeEntry, entry.desktop != true,
+              UIApplication.shared.applicationState == .active else { return }
+        let key = Self.key(entry)
+        seconds[key, default: 0] += Self.step
+        UserDefaults.standard.set(seconds, forKey: Self.storeKey)
+    }
+
+    func text(_ key: String) -> String? {
+        guard let total = seconds[key], total >= 60 else { return nil }
+        let minutes = total / 60
+        if minutes < 60 { return L("%lld min on Mango Port").replacingOccurrences(of: "%lld", with: String(minutes)) }
+        return String(format: L("%.1f hrs on Mango Port"), Double(total) / 3600)
+    }
+}
+
+/// "2.3 hrs on Mango Port", under a game's hours on Steam.
+struct MangoPlaytimeText: View {
+    let key: String
+    var font: Font = .caption2
+    @ObservedObject private var playtime = MangoPlaytime.shared
+
+    var body: some View {
+        if let text = playtime.text(key) {
+            Label(text, systemImage: "iphone").labelStyle(.titleAndIcon)
+                .font(font).foregroundStyle(MangoTheme.mango.opacity(0.9)).lineLimit(1)
+        }
+    }
+}
