+    /// clipboard works: copy the file's contents (StikDebug, Files, a note) and paste.
+    func pastePairingFile() {
+        let board = UIPasteboard.general
+        let data = board.data(forPasteboardType: "com.apple.property-list")
+            ?? board.data(forPasteboardType: "public.xml")
+            ?? board.string.map { Data($0.trimmingCharacters(in: .whitespacesAndNewlines).utf8) }
+        guard let data, !data.isEmpty else {
+            error = L("Nothing to paste. Copy the whole pairing file's text first, then tap Paste pairing file.")
+            return
+        }
+        do {
+            try JITPairingFileStore.store(data, source: .imported)
+            OnDevicePairing.shared.cancel()
+            refreshPairingStatus()
+            status = L("Pairing file pasted.")
+            error = nil
+            LogStore.shared.log("[jit-built-in] pairing file pasted (\(data.count) bytes)")
+        } catch {
+            self.error = error.localizedDescription
+        }
+    }
