+
+static int mc_ps_region_ok(const mc_ps_ctx *c, const mc_region *r)
+{
+    if (mc_scannable(r)) return 1;
+    /* A module's own data (statics) wherever Wine mapped it, even in the pool. */
+    for (int i = 0; i < c->nmods; i++)
+        if (r->readable && !r->ours && r->base < c->mods[i] + c->mod_size && r->base + r->size > c->mods[i]) return 1;
