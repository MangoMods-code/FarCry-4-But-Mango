+
+static int mc_in_mods(const mc_ps_ctx *c, uint64_t a)
+{
+    for (int i = 0; i < c->nmods; i++) if (a >= c->mods[i] && a < c->mods[i] + c->mod_size) return i + 1;
+    return 0;
