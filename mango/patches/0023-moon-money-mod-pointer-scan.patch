+
+/* Follows a chain from a module copy's base: the word at base + rva, plus the
+ * first offset; the word there, plus the next; ... The last address is the
+ * value's. Returns 0 when a step cannot be read or leaves the user range. */
+int mango_cheat_resolve(uint64_t base, uint64_t rva, const uint32_t *offs, int n, uint64_t *out)
+{
+    uint64_t p = base + rva;
+    for (int i = 0; i < n; i++) {
+        uint64_t v;
+        if (!mc_read(p, &v, 8) || v < 0x10000 || v >= 0x0001000000000000ULL) return 0;
+        p = v + offs[i];
+    }
+    *out = p;
+    return 1;
+}
