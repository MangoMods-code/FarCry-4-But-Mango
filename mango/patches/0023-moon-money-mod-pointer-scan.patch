+/* Reads [base, base+n) page run by page run, only pages in memory or
+ * compressed (file-backed regions: all of it), calling fn on each run that
+ * was read into mc_buf + (its offset in the chunk). */
+static void mc_read_resident(const mc_region *r, uint64_t base, uint64_t n,
+                             void (*fn)(uint64_t at, const uint8_t *p, uint64_t len, void *), void *ctx)
+{
+    if (r->external) {
+        if (mc_read(base, mc_buf, n)) fn(base, mc_buf, n, ctx);
+        return;
+    }
+    unsigned char vec[(MANGO_CHEAT_CHUNK / MANGO_CHEAT_PAGE) + 2];
+    uint64_t first = base & ~(uint64_t)(MANGO_CHEAT_PAGE - 1);
+    uint64_t pages = (base + n - first + MANGO_CHEAT_PAGE - 1) / MANGO_CHEAT_PAGE;
+    if (pages > sizeof vec || mincore((void *)(uintptr_t)first, pages * MANGO_CHEAT_PAGE, (void *)vec) != 0) {
+        mc_mincore_failures++;   /* no answer: skipped, never read blind (it could fault in a reservation) */
+        return;
