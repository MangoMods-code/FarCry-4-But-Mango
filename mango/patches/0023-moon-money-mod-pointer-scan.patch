+/* A PE image in memory whose export directory names `name` (case-insensitive),
+ * found by its headers at 64 KB boundaries of readable regions. Up to cap
+ * copies (Wine can map an image and keep a copy for execution). Returns how
+ * many were found; size and stamp (TimeDateStamp, the build) of the first. */
+typedef struct { const char *name; uint64_t *bases; int cap, found; uint64_t size; uint32_t stamp; } mc_mod_ctx;
+
+static int mc_name_eq(const char *a, const char *b)
+{
+    for (; *a && *b; a++, b++) {
+        char x = *a, y = *b;
+        if (x >= 'A' && x <= 'Z') x += 32;
+        if (y >= 'A' && y <= 'Z') y += 32;
+        if (x != y) return 0;
+    }
+    return *a == *b;
+}
+
+static int mc_pe_named(uint64_t base, const char *name, uint64_t *size, uint32_t *stamp)
+{
+    uint8_t h[0x200];
+    if (!mc_read(base, h, sizeof h) || h[0] != 'M' || h[1] != 'Z') return 0;
+    uint32_t lfanew = mc_u32(h + 0x3c);
+    if (lfanew < 0x40 || lfanew > 0x1000) return 0;
+    uint8_t nt[0x108];
+    if (!mc_read(base + lfanew, nt, sizeof nt) || memcmp(nt, "PE\0\0", 4) != 0) return 0;
+    uint32_t ts = mc_u32(nt + 8);
+    const uint8_t *opt = nt + 24;
+    uint16_t magic = (uint16_t)(opt[0] | opt[1] << 8);
+    uint32_t image = mc_u32(opt + 56);
+    uint32_t exp_rva = magic == 0x20b ? mc_u32(opt + 112) : magic == 0x10b ? mc_u32(opt + 96) : 0;
+    if (!exp_rva || !image || exp_rva >= image) return 0;
+    uint8_t ed[40];
+    if (!mc_read(base + exp_rva, ed, sizeof ed)) return 0;
+    uint32_t name_rva = mc_u32(ed + 12);
+    if (!name_rva || name_rva >= image) return 0;
+    char got[64] = {0};
+    if (!mc_read(base + name_rva, got, sizeof got - 1)) return 0;
+    if (!mc_name_eq(got, name)) return 0;
+    *size = image; *stamp = ts;
+    return 1;
+}
+
+static void mc_mod_region(const mc_region *r, void *vctx)
+{
+    mc_mod_ctx *c = vctx;
+    if (!r->readable || !r->resident || r->stack || r->ours || c->found >= c->cap) return;
+    uint64_t first = (r->base + 0xffff) & ~0xffffULL;
+    for (uint64_t a = first; a + 0x200 <= r->base + r->size && c->found < c->cap; a += 0x10000) {
+        /* only a page that is in memory: never fault in a reservation */
+        unsigned char v = 0;
+        if (!r->external && (mincore((void *)(uintptr_t)a, MANGO_CHEAT_PAGE, (void *)&v) != 0 || !(v & 0x21))) continue;
