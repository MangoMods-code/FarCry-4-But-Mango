+
+static void mc_ps_run(uint64_t at, const uint8_t *p, uint64_t len, void *vctx)
+{
+    mc_ps_ctx *c = vctx;
+    uint64_t start = (8 - (at & 7)) & 7;
+    for (uint64_t i = start; i + 8 <= len; i += 8) {
+        uint64_t v = mc_u64(p + i);
+        if (v < c->lo || v > c->hi) continue;
+        /* the nearest node at or above v */
+        uint32_t l = 0, h = c->nprev;
+        while (l < h) { uint32_t m = (l + h) / 2; if (c->prev[m].addr < v) l = m + 1; else h = m; }
+        if (l >= c->nprev || c->prev[l].addr - v > c->max_off) continue;
+        if (c->nnext >= MC_PS_NODES) return;
+        c->next[c->nnext].addr = at + i;
+        c->next[c->nnext].parent = l;
+        c->next[c->nnext].off = (uint32_t)(c->prev[l].addr - v);
+        c->nnext++;
+    }
+}
+
+static void mc_ps_total(const mc_region *r, void *vctx)
+{
+    mc_ps_ctx *c = vctx;
+    if (mc_ps_region_ok(c, r)) c->total += r->size;
+}
+
+static void mc_ps_region(const mc_region *r, void *vctx)
+{
+    mc_ps_ctx *c = vctx;
+    if (!mc_ps_region_ok(c, r) || c->nnext >= MC_PS_NODES) return;
+    for (uint64_t off = 0; off < r->size && !atomic_load(&mc_cancel) && c->nnext < MC_PS_NODES; off += MANGO_CHEAT_CHUNK) {
+        uint64_t n = r->size - off < MANGO_CHEAT_CHUNK ? r->size - off : MANGO_CHEAT_CHUNK;
+        mc_read_resident(r, r->base + off, n, mc_ps_run, c);
+        c->done += n;
+    }
+}
