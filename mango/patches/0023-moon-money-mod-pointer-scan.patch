+/// The Cheats page's Moon Sweepers money card.
+struct MangoMoonMoneySection: View {
+    @ObservedObject private var mod = MangoMoonMoney.shared
+
+    var body: some View {
+        Section {
+            switch mod.phase {
+            case .looking:
+                HStack { ProgressView(); Text("Looking for your money…") }
+            case .finding, .learning:
+                ProgressView(value: mod.progress) { Text(mod.phase == .learning ? "Saving where your money lives, for next time…" : "Scanning…") }
+                if mod.phase == .learning { moneyControls }
+            case .ready:
+                moneyControls
+            case .idle, .notFound, .narrowing:
+                finder
+            }
+            if !mod.note.isEmpty { Text(mod.note).font(.caption).foregroundStyle(MangoTheme.mango) }
+        } header: {
+            Label("Moon Sweepers money", systemImage: "dollarsign.circle.fill")
+        } footer: {
+            Text("Changes your money in the running game, like a PC trainer. The first time, it finds your money by scanning; after that it remembers where it lives, so it's there at once. Solo play only: keep it out of co-op.")
+        }
+        .onAppear { mod.open() }
+    }
+
+    @ViewBuilder private var finder: some View {
+        if case .notFound(let why) = mod.phase { Text(why).font(.caption).foregroundStyle(.orange) }
+        TextField("Your money, e.g. 167.47", text: $mod.amountText).keyboardType(.decimalPad)
+        if case .narrowing(let n) = mod.phase {
+            Text("\(n) matches. Earn or spend a little in the game, type the new amount above and tap Update.")
+                .font(.caption).foregroundStyle(.secondary)
+            HStack {
+                Button("Update") { mod.update() }.buttonStyle(.borderedProminent)
+                Spacer()
+                Button("Start over") { mod.find() }.buttonStyle(.borderless)
+            }
+        } else {
+            Text("Check the amount matches what the game shows (it starts from your last save), then tap Find.")
+                .font(.caption).foregroundStyle(.secondary)
+            Button("Find my money", systemImage: "magnifyingglass") { mod.find() }.buttonStyle(.borderedProminent)
+        }
+    }
+
+    @ViewBuilder private var moneyControls: some View {
+        LabeledContent("Money") { Text(mod.money).font(.title3.monospacedDigit().bold()).foregroundStyle(MangoTheme.mango) }
+        // A pointer scan holds the scanner: writes wait until it ends (MangoCheat.inc.c's lock).
+        HStack {
+            ForEach([1_000.0, 10_000, 100_000], id: \.self) { amount in
+                Button("+\(Int(amount).formatted())") { mod.add(amount) }.buttonStyle(.bordered)
+            }
+        }.disabled(mod.phase == .learning)
+        HStack {
+            TextField("Set to…", text: $mod.setText).keyboardType(.decimalPad)
+            Button("Set") { if let v = MangoCheats.parse(mod.setText)?.0 { mod.set(v) } }
+                .buttonStyle(.borderedProminent).disabled(MangoCheats.parse(mod.setText) == nil)
+        }.disabled(mod.phase == .learning)
+        Toggle("Lock money", isOn: Binding(get: { mod.locked }, set: { mod.lock($0) }))
+        Button("Not my money? Find it again", role: .destructive) { mod.forget() }.font(.caption)
+    }
+}
