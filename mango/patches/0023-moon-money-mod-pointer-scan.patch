+/* From a value's address back to a module's image: level 0 is the address;
+ * a word anywhere that points at most max_off below a level-(d-1) node is a
+ * level-d node (its offset is the distance). A node inside one of the module's
+ * copies is a root: its chain (rva, then the offsets from the root down) reads
+ * the same address after the next launch, when the heap is somewhere else.
+ * Each level is one pass over memory; at most MC_PS_NODES nodes per level. */
+#define MC_PS_DEPTH 6
+#define MC_PS_NODES 30000
+typedef struct { uint64_t addr; uint32_t parent; uint32_t off; } mc_node;
+
+typedef struct {
+    mc_node *prev; uint32_t nprev;          /* sorted by addr */
+    mc_node *next; uint32_t nnext;
+    uint64_t lo, hi;                        /* pointer values worth a look */
+    uint32_t max_off;
+    const uint64_t *mods; int nmods; uint64_t mod_size;
+    uint64_t done, total;
