+    private var moduleBases: [UInt64] = []
+    private var moduleSize: UInt64 = 0
+
+    /// The newest save's money (slot.json of the slot saved last), as the box's first guess.
+    nonisolated static func lastSavedMoney() -> Double? {
+        let slots = (1...6).compactMap { MangoMoonSave.slotFolder($0) }
+        let newest = slots.max { a, b in
+            let da = (try? a.appendingPathComponent("slot.json").resourceValues(forKeys: [.contentModificationDateKey]))?.contentModificationDate ?? .distantPast
+            let db = (try? b.appendingPathComponent("slot.json").resourceValues(forKeys: [.contentModificationDateKey]))?.contentModificationDate ?? .distantPast
+            return da < db
+        }
+        return newest.flatMap { MangoMoonSave.slotDollars($0) }
+    }
+
+    static func dollars(_ v: Double) -> String { String(format: "%.2f", v) }
+
+    /// Opening the page: the saved path when it still reads a sensible amount, else the finder.
+    func open() {
+        if phase == .ready || phase == .looking || phase == .finding || phase == .learning { refresh(); return }
+        if case .narrowing = phase { refresh(); return }
+        phase = .looking
+        Task {
+            let saved = await Task.detached(priority: .userInitiated) { MangoMoonMoney.lastSavedMoney() }.value
+            if amountText.isEmpty, let saved { amountText = Self.dollars(saved) }
+            let found = await Task.detached(priority: .userInitiated) { () -> (String?, [UInt64], UInt64) in
+                var bases = [UInt64](repeating: 0, count: 4), size: UInt64 = 0, stamp: UInt32 = 0
+                let n = Int(mango_cheat_find_module("GameAssembly.dll", &bases, 4, &size, &stamp))
+                guard n > 0 else { return (nil, [], 0) }
+                return ("\(stamp)-\(size)", Array(bases.prefix(n)), size)
+            }.value
+            moduleKey = found.0; moduleBases = found.1; moduleSize = found.2
+            LogStore.shared.log("[moon-money] GameAssembly.dll copies=\(found.1.count) build=\(found.0 ?? "none")")
+            if let hit = resolveSaved(near: saved) {
+                targets = [hit]; phase = .ready; refresh()
+                LogStore.shared.log("[moon-money] saved path found the money at once")
+            } else {
+                phase = .idle
+            }
+        }
+    }
+
+    /// The saved chains for this build; the one whose amount matches the last save wins, else the
+    /// first that reads a sensible amount.
+    private func resolveSaved(near saved: Double?) -> Target? {
+        guard let key = moduleKey, let lines = (UserDefaults.standard.dictionary(forKey: Self.store) as? [String: [String]])?[key] else { return nil }
+        var plausible: [(Target, Double)] = []
+        for line in lines {
+            let parts = line.split(separator: " ").compactMap { UInt64($0, radix: 16) }
+            guard parts.count >= 4 else { continue }
+            let kind = Int32(parts[0]), copy = Int(parts[1]), rva = parts[2]
+            let offs = parts.dropFirst(3).map { UInt32(truncatingIfNeeded: $0) }
+            let order = (moduleBases.indices.contains(copy) ? [copy] : []) + moduleBases.indices.filter { $0 != copy }
+            for i in order {
+                var address: UInt64 = 0, value = 0.0
+                guard mango_cheat_resolve(moduleBases[i], rva, offs, Int32(offs.count), &address) != 0,
+                      mango_cheat_peek(address, kind, &value) != 0, value.isFinite, value >= 0, value < 1e12 else { continue }
+                plausible.append((Target(address: address, kind: kind), value))
+                break
+            }
+        }
+        if let saved, let match = plausible.first(where: { abs($0.1 - saved) < 0.02 }) { return match.0 }
+        return plausible.first?.0
+    }
+
+    /// Step 1: every money kind holding the amount typed (the save's amount to start).
+    func find() {
+        guard MangoCheats.parse(amountText) != nil else { note = "Type the money the game shows."; return }
+        phase = .finding; note = ""
+        let text = amountText
+        poll()
+        Task {
+            let n = await Task.detached(priority: .userInitiated) { () -> Int in
+                guard let p = MangoCheats.parse(text) else { return 0 }
+                return mango_cheat_first_scan_money(p.0, max(p.1, 2))
+            }.value
+            LogStore.shared.log("[moon-money] scan \(n) results (mincore failures \(mango_cheat_mincore_failures()))")
+            settle(n)
+        }
+    }
+
+    /// Step 2: the amount after earning or spending some.
+    func update() {
+        guard MangoCheats.parse(amountText) != nil else { note = "Type the money the game shows now."; return }
+        phase = .finding; note = ""
+        let text = amountText
+        poll()
+        Task {
+            let n = await Task.detached(priority: .userInitiated) { () -> Int in
+                guard let p = MangoCheats.parse(text) else { return 0 }
+                return mango_cheat_next_scan(0, p.0, max(p.1, 2))
+            }.value
+            settle(n)
+        }
+    }
+
+    private func poll() {
+        progress = 0
+        Task { @MainActor in
+            while phase == .finding || phase == .learning { progress = Double(mango_cheat_progress()) / 1000; try? await Task.sleep(for: .milliseconds(150)) }
+        }
+    }
+
+    private func settle(_ n: Int) {
+        if n <= 0 {
+            phase = .notFound("Not found. Check the amount (the game's own number, with cents), then Find again. Some numbers are only updated once the game shows them, so open the screen with your money first.")
+            return
+        }
+        if n > 6 { phase = .narrowing(n); return }
+        var found: [Target] = []
+        for i in 0..<n {
+            var address: UInt64 = 0, kind: Int32 = 0, value = 0.0
+            if mango_cheat_result(i, &address, &kind, &value) != 0 { found.append(Target(address: address, kind: kind)) }
+        }
+        targets = found
+        phase = .ready
+        refresh()
+        learn()
+    }
+
+    /// Step 3, in the background: a path from GameAssembly.dll to the money, saved for next time.
+    private func learn() {
+        guard let key = moduleKey, !moduleBases.isEmpty, let first = targets.first else {
+            note = "Found. (GameAssembly.dll wasn't seen, so next launch finds it again by scanning.)"; return
+        }
+        let bases = moduleBases, size = moduleSize, all = targets
+        phase = .learning
+        poll()
+        Task {
+            let lines = await Task.detached(priority: .utility) { () -> [String] in
+                var out: [String] = []
+                for t in all.prefix(3) {
+                    var buffer = [CChar](repeating: 0, count: 1 << 16)
+                    let n = mango_cheat_pointer_scan(t.address, bases, Int32(bases.count), size, 6, 0x1000, &buffer, Int(buffer.count))
+                    guard n > 0 else { continue }
+                    let text = String(cString: buffer)
+                    out += text.split(separator: "\n").prefix(40).map { "\(String(t.kind, radix: 16)) \($0)" }
+                }
+                return out
+            }.value
+            var all = UserDefaults.standard.dictionary(forKey: Self.store) as? [String: [String]] ?? [:]
+            if !lines.isEmpty { all[key] = lines; UserDefaults.standard.set(all, forKey: Self.store) }
+            LogStore.shared.log("[moon-money] pointer scan from \(String(first.address, radix: 16)): \(lines.count) paths saved")
+            phase = .ready
+            note = lines.isEmpty ? "Found. No saved path this time, so next launch scans again." : "Found, and saved: next launch finds your money at once."
+            refresh()
+        }
+    }
+
+    func refresh() {
+        guard let t = targets.first else { money = ""; return }
+        var v = 0.0
+        money = mango_cheat_peek(t.address, t.kind, &v) != 0 ? "$" + Self.dollars(v) : "gone"
+        if money == "gone" { phase = .notFound("The game moved its money (a new save loaded?). Find it again."); targets = [] }
+    }
+
+    func set(_ value: Double) {
+        let v = max(0, min(value, 999_999_999))
+        var done = 0
+        for t in targets where mango_cheat_set(t.address, t.kind, v) != 0 { done += 1 }
+        if locked { for t in targets { _ = mango_cheat_freeze(t.address, t.kind, v, 1) } }
+        note = done > 0 ? "Money set to $\(Self.dollars(v)). Earn or spend anything if the screen still shows the old amount." : "Couldn't write it. Find your money again."
+        LogStore.shared.log("[moon-money] set \(Self.dollars(v)) on \(done) of \(targets.count)")
+        refresh()
+    }
+
+    func add(_ amount: Double) {
+        guard let t = targets.first else { return }
+        var v = 0.0
+        guard mango_cheat_peek(t.address, t.kind, &v) != 0 else { return }
+        set(v + amount)
+    }
+
+    func lock(_ on: Bool) {
+        locked = on
+        guard let t = targets.first else { return }
+        var v = 0.0
+        _ = mango_cheat_peek(t.address, t.kind, &v)
+        for t in targets { _ = mango_cheat_freeze(t.address, t.kind, v, on ? 1 : 0) }
+    }
+
+    /// The saved path for this build is wrong (a game update): forget it.
+    func forget() {
+        if let key = moduleKey, var all = UserDefaults.standard.dictionary(forKey: Self.store) as? [String: [String]] {
+            all[key] = nil; UserDefaults.standard.set(all, forKey: Self.store)
+        }
+        lock(false); targets = []; phase = .idle; note = ""
+    }
+
+    /// A session ended: addresses are gone (the saved path stays).
+    func endSession() { locked = false; targets = []; money = ""; note = ""; phase = .idle }
+}
