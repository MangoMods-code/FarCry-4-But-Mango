+    while (i < pages) {
+        /* 0x1 in core, 0x20 paged out (compressed or swapped): data that exists */
+        if (!(vec[i] & 0x21)) { i++; continue; }
+        uint64_t j = i;
+        while (j < pages && (vec[j] & 0x21)) j++;
+        uint64_t s = first + i * MANGO_CHEAT_PAGE, e = first + j * MANGO_CHEAT_PAGE;
+        if (s < base) s = base;
+        if (e > base + n) e = base + n;
+        if (e > s && mc_read(s, mc_buf + (s - base), e - s)) fn(s, mc_buf + (s - base), e - s, ctx);
+        i = j;
+    }
