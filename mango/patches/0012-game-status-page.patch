+// MARK: - Mango Port: the online status list and the Game status page
+
+/// The tested-games list, kept online as status/games.json in Mango Port's GitHub repo so it
+/// changes without a new build. Everyone reads it (raw.githubusercontent.com, no account);
+/// only the owner, whose GitHub token is in this iPhone's Keychain (MangoOwnerKey), writes it,
+/// through GitHub's contents API. A copy is kept in Documents for offline starts.
+final class MangoStatusStore: ObservableObject {
+    static let shared = MangoStatusStore()
+    struct Game: Codable, Identifiable, Equatable {
+        var appID: Int
+        var name: String
+        var status: String
+        var note: String
+        var updated: String
+        var id: Int { appID }
+    }
+    private struct File: Codable {
+        var version: Int
+        var games: [Game]
+    }
+    enum StatusError: LocalizedError {
+        case noKey, http(Int)
+        var errorDescription: String? {
+            switch self {
+            case .noKey: return L("Add your owner key first: long-press the text at the top of Game status.")
+            case .http(let code) where code == 401 || code == 403 || code == 404:
+                return L("GitHub didn't accept your owner key (\(code)). Check that the token can read and write this repo's contents, and that it hasn't expired.")
+            case .http(409): return L("The list changed while saving. Pull to refresh and try again.")
+            case .http(let code): return L("GitHub answered \(code). Try again in a moment.")
+            }
+        }
+    }
+    static let repo = "MangoMods-code/FarCry-4-But-Mango"
+    static let path = "status/games.json"
+    static let rawURL = URL(string: "https://raw.githubusercontent.com/\(repo)/main/\(path)")!
+    static let apiURL = URL(string: "https://api.github.com/repos/\(repo)/contents/\(path)")!
+    private static var cacheURL: URL { LibraryModel.documents.appendingPathComponent("mango-status.json") }
+
+    /// nil until the list has been read once (then the cached copy is used at start).
+    @Published private(set) var remote: [Game]?
+    @Published private(set) var lastError: String?
+
+    init() {
+        if let data = try? Data(contentsOf: Self.cacheURL), let file = try? JSONDecoder().decode(File.self, from: data) {
+            remote = file.games
+        }
+    }
+
+    @MainActor func refresh() async {
+        do {
+            // The query string keeps the CDN and URLCache from answering with an old copy.
+            var parts = URLComponents(url: Self.rawURL, resolvingAgainstBaseURL: false)!
+            parts.queryItems = [URLQueryItem(name: "t", value: String(Int(Date().timeIntervalSince1970)))]
+            let request = URLRequest(url: parts.url!, cachePolicy: .reloadIgnoringLocalCacheData, timeoutInterval: 15)
+            let (data, response) = try await URLSession.shared.data(for: request)
+            let code = (response as? HTTPURLResponse)?.statusCode ?? 0
+            guard code == 200 else { throw StatusError.http(code) }
+            let file = try JSONDecoder().decode(File.self, from: data)
+            remote = file.games
+            lastError = nil
+            try? data.write(to: Self.cacheURL, options: .atomic)
+            LogStore.shared.log("[mango-status] list read: \(file.games.count) game(s)")
+        } catch {
+            lastError = error.localizedDescription
+            LogStore.shared.log("[mango-status] list not read: \(error.localizedDescription)")
+        }
+    }
+
+    /// Owner only: reads the file as GitHub has it now, applies `edit`, and writes it back
+    /// (with its sha, so a change made meanwhile is not overwritten).
+    @MainActor func change(message: String, _ edit: (inout [Game]) -> Void) async throws {
+        guard let token = MangoOwnerKey.read() else { throw StatusError.noKey }
+        var get = URLRequest(url: Self.apiURL, cachePolicy: .reloadIgnoringLocalCacheData, timeoutInterval: 20)
+        Self.authorize(&get, token)
+        let (data, response) = try await URLSession.shared.data(for: get)
+        let code = (response as? HTTPURLResponse)?.statusCode ?? 0
+        var games: [Game] = []
+        var sha: String?
+        if code == 200 {
+            let object = try JSONSerialization.jsonObject(with: data) as? [String: Any]
+            sha = object?["sha"] as? String
+            if let content = object?["content"] as? String,
+               let raw = Data(base64Encoded: content, options: .ignoreUnknownCharacters),
+               let file = try? JSONDecoder().decode(File.self, from: raw) {
+                games = file.games
+            }
+        } else if code != 404 {
+            throw StatusError.http(code)
+        }
+        edit(&games)
+        games.sort { $0.name.localizedCaseInsensitiveCompare($1.name) == .orderedAscending }
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
+        let body = try encoder.encode(File(version: 1, games: games))
+        var payload: [String: Any] = ["message": message, "content": body.base64EncodedString(), "branch": "main"]
+        if let sha { payload["sha"] = sha }
+        var put = URLRequest(url: Self.apiURL, timeoutInterval: 20)
+        put.httpMethod = "PUT"
+        Self.authorize(&put, token)
+        put.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        put.httpBody = try JSONSerialization.data(withJSONObject: payload)
+        let (_, putResponse) = try await URLSession.shared.data(for: put)
+        let putCode = (putResponse as? HTTPURLResponse)?.statusCode ?? 0
+        guard putCode == 200 || putCode == 201 else { throw StatusError.http(putCode) }
+        remote = games
+        lastError = nil
+        try? body.write(to: Self.cacheURL, options: .atomic)
+        LogStore.shared.log("[mango-status] list saved: \(games.count) game(s)")
+    }
+
+    private static func authorize(_ request: inout URLRequest, _ token: String) {
+        request.setValue("Bearer \(token)", forHTTPHeaderField: "Authorization")
+        request.setValue("application/vnd.github+json", forHTTPHeaderField: "Accept")
+        request.setValue("2022-11-28", forHTTPHeaderField: "X-GitHub-Api-Version")
+        request.setValue("MangoPort", forHTTPHeaderField: "User-Agent")
+    }
+}
+
+/// The owner's GitHub token (a fine-grained token for this repo with Contents: read and
+/// write), in this iPhone's Keychain only: never in Documents, never synced.
+enum MangoOwnerKey {
+    private static var base: [String: Any] {
+        [kSecClass as String: kSecClassGenericPassword,
+         kSecAttrService as String: "MangoPortStatusOwner",
+         kSecAttrAccount as String: "github"]
+    }
+    static func read() -> String? {
+        var query = base
+        query[kSecReturnData as String] = true
+        query[kSecMatchLimit as String] = kSecMatchLimitOne
+        var item: CFTypeRef?
+        guard SecItemCopyMatching(query as CFDictionary, &item) == errSecSuccess, let data = item as? Data else { return nil }
+        return String(data: data, encoding: .utf8)
+    }
+    @discardableResult static func save(_ key: String) -> Bool {
+        SecItemDelete(base as CFDictionary)
+        var add = base
+        add[kSecValueData as String] = Data(key.utf8)
+        add[kSecAttrAccessible as String] = kSecAttrAccessibleWhenUnlockedThisDeviceOnly
+        return SecItemAdd(add as CFDictionary, nil) == errSecSuccess
+    }
+    static func remove() { SecItemDelete(base as CFDictionary) }
+}
+
+/// Settings › Game status, and the Game status button on the library: every tested game by
+/// status, with its note and test date. With the owner key on this iPhone: + to add a game,
+/// a tap to change one, a swipe to remove one. Long-press the text at the top for the key.
+struct MangoStatusPage: View {
+    @ObservedObject private var store = MangoStatusStore.shared
+    @State private var search = ""
+    @State private var owner = MangoOwnerKey.read() != nil
+    @State private var keySheet = false
+    @State private var editing: MangoStatusStore.Game?
+    @State private var adding = false
+    @State private var failure: String?
+    @State private var saving = false
+
+    init() {}
+
+    private var shown: [MangoStatusStore.Game] {
+        let all = store.remote ?? MangoCompat.builtInList
+        let query = search.trimmingCharacters(in: .whitespaces)
+        return query.isEmpty ? all : all.filter { $0.name.localizedCaseInsensitiveContains(query) }
+    }
+
+    var body: some View {
+        List {
+            Section {
+                Text(owner ? L("Owner mode: tap a game to change its status, swipe to remove it, or tap + to add one.")
+                           : L("How each game runs in Mango Port, tested by MangoMods. A game that isn't listed hasn't been tested yet."))
+                    .font(.footnote).foregroundStyle(.secondary)
+                    .contentShape(Rectangle())
+                    .onLongPressGesture(minimumDuration: 1.2) { keySheet = true }
+            }
+            ForEach(MangoCompat.Status.allCases, id: \.self) { status in
+                let games = shown.filter { $0.status == status.rawValue }
+                if !games.isEmpty {
+                    Section {
+                        ForEach(games) { game in
+                            row(game)
+                                .contentShape(Rectangle())
+                                .onTapGesture { if owner { editing = game } }
+                                .swipeActions {
+                                    if owner {
+                                        Button(role: .destructive) { remove(game) } label: { Label("Remove", systemImage: "trash") }
+                                    }
+                                }
+                        }
+                    } header: { MangoCompatLabel(status: status) }
+                }
+            }
+            if shown.isEmpty {
+                Section { Text(search.isEmpty ? L("No games tested yet.") : L("No tested game matches your search.")).foregroundStyle(.secondary) }
+            }
+            if let failure { Section { Text(verbatim: failure).foregroundStyle(.red) } }
+            if saving { Section { HStack(spacing: 10) { ProgressView(); Text(verbatim: L("Saving…")) } } }
+        }
+        .searchable(text: $search)
+        .refreshable { await store.refresh() }
+        .navigationTitle(L("Game status"))
+        .toolbar {
+            if owner {
+                ToolbarItem(placement: .topBarTrailing) {
+                    Button { adding = true } label: { Label(L("Add game"), systemImage: "plus") }
+                }
+            }
+        }
+        .sheet(isPresented: $keySheet) { MangoOwnerKeySheet(owner: $owner) }
+        .sheet(item: $editing) { game in MangoStatusEditor(game: game, isNew: false) { save($0) } }
+        .sheet(isPresented: $adding) {
+            MangoStatusEditor(game: MangoStatusStore.Game(appID: 0, name: "", status: MangoCompat.Status.works.rawValue, note: "", updated: ""), isNew: true) { save($0) }
+        }
+        .task { await store.refresh() }
+    }
+
+    private func row(_ game: MangoStatusStore.Game) -> some View {
+        HStack(spacing: 12) {
+            SteamGameArtwork(appID: game.appID).frame(width: 40, height: 60)
+                .clipShape(RoundedRectangle(cornerRadius: 8, style: .continuous))
+            VStack(alignment: .leading, spacing: 3) {
+                Text(verbatim: game.name).font(.system(.body, design: .rounded).weight(.heavy))
+                if !game.note.isEmpty { Text(verbatim: game.note).font(.footnote).foregroundStyle(.secondary) }
+                if !game.updated.isEmpty { Text(verbatim: L("Tested") + " " + game.updated).font(.caption2).foregroundStyle(.tertiary) }
+            }
+        }
+        .padding(.vertical, 2)
+    }
+
+    private static var today: String {
+        let formatter = DateFormatter()
+        formatter.locale = Locale(identifier: "en_US_POSIX")
+        formatter.dateFormat = "yyyy-MM-dd"
+        return formatter.string(from: Date())
+    }
+
+    private func save(_ game: MangoStatusStore.Game) {
+        var game = game
+        game.name = game.name.trimmingCharacters(in: .whitespaces)
+        game.updated = Self.today
+        run("Mango Port status: \(game.name) is \(game.status)") { list in
+            list.removeAll { $0.appID == game.appID }
+            list.append(game)
+        }
+    }
+
+    private func remove(_ game: MangoStatusStore.Game) {
+        run("Mango Port status: remove \(game.name)") { list in list.removeAll { $0.appID == game.appID } }
+    }
+
+    private func run(_ message: String, _ edit: @escaping (inout [MangoStatusStore.Game]) -> Void) {
+        saving = true
+        Task { @MainActor in
+            do {
+                try await store.change(message: message, edit)
+                failure = nil
+                UINotificationFeedbackGenerator().notificationOccurred(.success)
+            } catch let error {
+                failure = error.localizedDescription
+                UINotificationFeedbackGenerator().notificationOccurred(.error)
+            }
+            saving = false
+        }
+    }
+}
