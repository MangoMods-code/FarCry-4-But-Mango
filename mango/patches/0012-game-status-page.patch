+/// Owner mode: the GitHub token goes into the Keychain, or comes out.
+struct MangoOwnerKeySheet: View {
+    @Binding var owner: Bool
+    @Environment(\.dismiss) private var dismiss
+    @State private var key = ""
+
+    var body: some View {
+        NavigationStack {
+            Form {
+                Section {
+                    SecureField(L("Owner key"), text: $key)
+                } footer: {
+                    Text(verbatim: L("A GitHub fine-grained token for the Mango Port repo with Contents: read and write. It stays in this iPhone's Keychain."))
+                }
+                if owner {
+                    Section {
+                        Button(L("Remove owner key"), role: .destructive) { MangoOwnerKey.remove(); owner = false; dismiss() }
+                    }
+                }
+            }
+            .navigationTitle(L("Owner mode")).navigationBarTitleDisplayMode(.inline)
+            .toolbar {
+                ToolbarItem(placement: .cancellationAction) { Button(L("Cancel")) { dismiss() } }
+                ToolbarItem(placement: .confirmationAction) {
+                    Button(L("Save")) {
+                        owner = MangoOwnerKey.save(key.trimmingCharacters(in: .whitespacesAndNewlines))
+                        dismiss()
+                    }
+                    .disabled(key.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty)
+                }
+            }
+        }
+    }
+}
+
+/// Adding a game (from the installed Steam games or by App ID) or changing one's status and note.
+struct MangoStatusEditor: View {
+    @State var game: MangoStatusStore.Game
+    let isNew: Bool
+    var save: (MangoStatusStore.Game) -> Void
+    @Environment(\.dismiss) private var dismiss
+    @ObservedObject private var steamGames = SteamGamesModel.shared
+    @State private var appIDText = ""
+
+    var body: some View {
+        NavigationStack {
+            Form {
+                if isNew {
+                    Section {
+                        Menu {
+                            ForEach(steamGames.games) { installed in
+                                Button(installed.name) { game.appID = installed.id; game.name = installed.name; appIDText = String(installed.id) }
+                            }
+                        } label: { Label(L("Pick from your installed Steam games"), systemImage: "gamecontroller") }
+                        TextField(L("Steam App ID"), text: $appIDText)
+                            .keyboardType(.numberPad)
+                            .onChange(of: appIDText) { _, text in game.appID = Int(text.filter(\.isNumber)) ?? 0 }
+                        TextField(L("Name"), text: $game.name)
+                    } footer: {
+                        Text(verbatim: L("The App ID is the number in the game's Steam store link."))
+                    }
+                } else {
+                    Section {
+                        LabeledContent(L("Game"), value: game.name)
+                        LabeledContent(L("Steam App ID"), value: String(game.appID))
+                    }
+                }
+                Section {
+                    Picker(L("Status"), selection: $game.status) {
+                        ForEach(MangoCompat.Status.allCases, id: \.self) { status in
+                            MangoCompatLabel(status: status).tag(status.rawValue)
+                        }
+                    }
+                    .pickerStyle(.inline)
+                    .labelsHidden()
+                } header: { Text(verbatim: L("Status")) }
+                Section {
+                    TextField(L("What works, and what doesn't"), text: $game.note, axis: .vertical).lineLimit(3...8)
+                } header: { Text(verbatim: L("Note")) }
+            }
+            .navigationTitle(isNew ? L("Add a game") : L("Edit status")).navigationBarTitleDisplayMode(.inline)
+            .toolbar {
+                ToolbarItem(placement: .cancellationAction) { Button(L("Cancel")) { dismiss() } }
+                ToolbarItem(placement: .confirmationAction) {
+                    Button(L("Save")) { save(game); dismiss() }
+                        .disabled(game.appID <= 0 || game.name.trimmingCharacters(in: .whitespaces).isEmpty)
+                }
+            }
+        }
+    }
+}
