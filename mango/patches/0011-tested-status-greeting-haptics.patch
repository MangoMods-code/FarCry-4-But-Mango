+/// Above Continue playing: a greeting for the time of day, and the library in one line
+/// (games ready to play, and the hours Steam counted on the installed ones).
+struct MangoGreeting: View {
+    @ObservedObject private var library = LibraryModel.shared
+    @ObservedObject private var steamGames = SteamGamesModel.shared
+    @ObservedObject private var steam = SteamOwnedLibrary.shared
+
+    private var greeting: String {
+        let hour = Calendar.current.component(.hour, from: Date())
+        switch hour {
+        case 5..<12: return L("Good morning")
+        case 12..<17: return L("Good afternoon")
+        case 17..<22: return L("Good evening")
+        default: return L("Late-night session")
+        }
+    }
+
+    var body: some View {
+        let installed = steamGames.games.filter(\.installed)
+        let added = library.entries.filter { game in game.desktop != true && game.listedInLibrary && game.steamAppID == nil }.count
+        let games = installed.count + added
+        let hours = installed.reduce(0) { $0 + (steam.playtime[$1.id]?.minutes ?? 0) } / 60
+        VStack(alignment: .leading, spacing: 2) {
+            Text(verbatim: greeting).font(.system(.title3, design: .rounded).weight(.heavy))
+            if games > 0 {
+                Text(verbatim: games == 1 ? L("1 game ready") + (hours > 0 ? " · \(hours) " + L("hrs played") : "")
+                                          : "\(games) " + L("games ready") + (hours > 0 ? " · \(hours) " + L("hrs played") : ""))
+                    .font(.system(.subheadline, design: .rounded).weight(.bold))
+                    .foregroundStyle(MangoTheme.muted)
+            }
+        }
+        .accessibilityElement(children: .combine)
+    }
+}
