+/// Mango Port's brand, shared with Mango Signer: a deep purple night, mango orange to
+/// gold, and the leaf's green. The accent colour app-wide is AccentColor (the asset
+/// catalog, ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME); the views below use these.
+enum MangoTheme {
+    static func rgb(_ hex: UInt32, _ alpha: Double = 1) -> Color {
+        Color(.sRGB, red: Double((hex >> 16) & 0xff) / 255, green: Double((hex >> 8) & 0xff) / 255,
+              blue: Double(hex & 0xff) / 255, opacity: alpha)
+    }
+    static let night = rgb(0x140c1a)
+    static let dusk = rgb(0x1d1326)
+    static let deep = rgb(0x120a17)
+    static let mango = rgb(0xff9f1c)
+    static let gold = rgb(0xffcf4a)
+    static let orange = rgb(0xff7a1a)
+    static let leaf = rgb(0x5cc45c)
+    static let leafText = rgb(0x8fe08f)
+    static let soft = rgb(0xd9cde3)
+    static let muted = rgb(0xa898b5)
+    static let onAccent = rgb(0x1a0d05)
+    /// A grid card's artwork corners (the library's and Steam's cards).
+    static let cardRadius: CGFloat = 18
+    static let wordGradient = LinearGradient(colors: [gold, orange], startPoint: .leading, endPoint: .trailing)
+    static let pillGradient = LinearGradient(colors: [gold, orange], startPoint: .top, endPoint: .bottom)
+    static let buttonGradient = LinearGradient(colors: [rgb(0xffb347), orange], startPoint: .top, endPoint: .bottom)
+}
+
+/// The library page's background: the night gradient with a mango glow in the top corner.
+struct MangoBackground: View {
+    var body: some View {
+        ZStack {
+            LinearGradient(colors: [MangoTheme.dusk, MangoTheme.night, MangoTheme.deep], startPoint: .top, endPoint: .bottom)
+            RadialGradient(colors: [MangoTheme.mango.opacity(0.22), MangoTheme.mango.opacity(0)],
+                           center: UnitPoint(x: 0.08, y: 0), startRadius: 0, endRadius: 460)
+        }
+        .ignoresSafeArea()
+        .accessibilityHidden(true)
+    }
+}
+
+/// The library's title: the mango, a small "F4", then "Mango" in the mango gradient and
+/// "Port", in the title font around it.
+/// Kept narrow (about 180 pt): it shares the navigation bar with the library's buttons, and
+/// a wider title pushed them into an overflow menu (v0.4.0 on a 6.1-inch iPhone).
+struct MangoWordmark: View {
+    var body: some View {
+        HStack(alignment: .center, spacing: 6) {
+            Image("MangoGlyph").resizable().scaledToFit().frame(width: 32, height: 32)
+            VStack(alignment: .leading, spacing: -3) {
+                Text(verbatim: "F4").font(.system(size: 10, weight: .black, design: .rounded)).tracking(2.2)
+                    .foregroundStyle(MangoTheme.muted)
+                (Text(verbatim: "Mango").foregroundStyle(MangoTheme.wordGradient) + Text(verbatim: " Port"))
+                    .font(.system(size: 25, weight: .black, design: .rounded))
+            }
+        }
+        .lineLimit(1)
+        .fixedSize()
+    }
+}
+
+/// JIT beside the title: a bolt in a green circle once the debugger is attached, a grey one before.
+struct MangoJITPill: View {
+    let on: Bool
+    var body: some View {
+        Image(systemName: "bolt.fill").font(.system(size: 13, weight: .heavy))
+            .foregroundStyle(on ? MangoTheme.leafText : MangoTheme.muted)
+            .frame(width: 28, height: 28)
+            .background(Circle().fill(on ? MangoTheme.leaf.opacity(0.18) : Color.white.opacity(0.08)))
+            .overlay(Circle().strokeBorder(on ? MangoTheme.leaf.opacity(0.35) : Color.white.opacity(0.1), lineWidth: 1))
+        .animation(UIAccessibility.isReduceMotionEnabled ? nil : .easeInOut(duration: 0.3), value: on)
+    }
+}
+
+/// Continue playing: the most recently played game you can start (a game you added, or an
+/// installed Steam game by its library entry's date or Steam's own, whichever is later),
+/// as a wide card at the top of the library. A tap opens its Game details page, where Play
+/// does every check a start needs. Nothing is shown before a game has been played.
+struct MangoContinueHero: View {
+    var open: (LibraryEntry) -> Void
+    @ObservedObject private var library = LibraryModel.shared
+    @ObservedObject private var steamGames = SteamGamesModel.shared
+    @ObservedObject private var steam = SteamOwnedLibrary.shared
+
+    private enum Pick {
+        case entry(LibraryEntry)
+        case steam(DockGame, String)
+    }
+
+    private var latest: (pick: Pick, played: Date)? {
+        var best: (pick: Pick, played: Date)?
+        for entry in library.entries where entry.desktop != true && entry.listedInLibrary && entry.steamAppID == nil {
+            if let played = entry.lastPlayed, played > (best?.played ?? .distantPast) { best = (pick: Pick.entry(entry), played: played) }
+        }
+        if SteamGamesSection.shown {
+            for item in SteamGamesRules.items(installed: steamGames.games, owned: [], search: "") {
+                guard let game = item.installed else { continue }
+                let recorded = library.entries.first { $0.steamAppID == item.id }?.lastPlayed
+                let fromSteam = steam.playtime[item.id].flatMap {
+                    $0.lastPlayed > 0 ? Date(timeIntervalSince1970: TimeInterval($0.lastPlayed)) : nil
+                }
+                if let played = [recorded, fromSteam].compactMap({ $0 }).max(), played > (best?.played ?? .distantPast) {
+                    best = (pick: Pick.steam(game, item.name), played: played)
+                }
+            }
+        }
+        return best
+    }
+
+    var body: some View {
+        if let latest {
+            Button { open(entry(for: latest.pick)) } label: { card(latest.pick, played: latest.played) }
+                .buttonStyle(.plain)
+                .accessibilityElement(children: .combine)
+                .accessibilityHint(L("Opens the game's details"))
+        }
+    }
+
+    private func entry(for pick: Pick) -> LibraryEntry {
+        switch pick {
+        case .entry(let entry): return entry
+        case .steam(let game, let name): return library.steamEntry(game, title: name)
+        }
+    }
+
+    private func title(_ pick: Pick) -> String {
+        switch pick {
+        case .entry(let entry): return entry.title
+        case .steam(_, let name): return name
+        }
+    }
+
+    /// The wide artwork: a game's chosen cover, else Steam's store art (LibraryArtwork, backdrop).
+    private func artworkEntry(_ pick: Pick) -> LibraryEntry {
+        switch pick {
+        case .entry(let entry): return entry
+        case .steam(let game, let name):
+            if let recorded = library.entries.first(where: { $0.steamAppID == game.id }) { return recorded }
+            var entry = LibraryEntry(title: name, relativePath: "", bits: 0)
+            entry.steamAppID = game.id
+            return entry
+        }
+    }
+
+    private func card(_ pick: Pick, played: Date) -> some View {
+        ZStack(alignment: .bottomLeading) {
+            LibraryArtwork(entry: artworkEntry(pick), backdrop: true)
+            LinearGradient(stops: [.init(color: MangoTheme.night.opacity(0), location: 0.2),
+                                   .init(color: MangoTheme.night.opacity(0.6), location: 0.5),
+                                   .init(color: MangoTheme.night.opacity(0.95), location: 1)],
+                           startPoint: .top, endPoint: .bottom)
+            RadialGradient(colors: [MangoTheme.gold.opacity(0.28), MangoTheme.gold.opacity(0)],
+                           center: UnitPoint(x: 0.9, y: 0.05), startRadius: 0, endRadius: 260)
+            VStack(alignment: .leading, spacing: 9) {
+                Text("Continue playing").textCase(.uppercase)
+                    .font(.system(size: 12, weight: .black, design: .rounded)).tracking(1.6)
+                    .foregroundStyle(MangoTheme.gold)
+                    .shadow(color: .black.opacity(0.6), radius: 3, y: 1)
+                Text(title(pick)).font(.system(size: 30, weight: .black, design: .rounded))
+                    .foregroundStyle(.white).lineLimit(1).minimumScaleFactor(0.6)
+                    .shadow(color: .black.opacity(0.5), radius: 6, y: 2)
+                HStack(spacing: 12) {
+                    HStack(spacing: 8) {
+                        Image(systemName: "play.fill")
+                        Text("Continue")
+                    }
+                    .font(.system(size: 17, weight: .black, design: .rounded))
+                    .foregroundStyle(MangoTheme.onAccent)
+                    .padding(.horizontal, 22).frame(height: 46)
+                    .background(Capsule().fill(MangoTheme.buttonGradient))
+                    .shadow(color: MangoTheme.mango.opacity(0.5), radius: 12, y: 6)
+                    Text(played, format: .relative(presentation: .named))
+                        .font(.system(size: 13, weight: .bold, design: .rounded))
+                        .foregroundStyle(MangoTheme.soft).lineLimit(1)
+                }
+            }
+            .padding(18)
+        }
+        .frame(maxWidth: .infinity)
+        .frame(height: 236)
+        .clipShape(RoundedRectangle(cornerRadius: 26, style: .continuous))
+        .overlay(RoundedRectangle(cornerRadius: 26, style: .continuous).strokeBorder(Color.white.opacity(0.08), lineWidth: 1))
+        .shadow(color: MangoTheme.mango.opacity(0.35), radius: 24, y: 14)
+        .contentShape(RoundedRectangle(cornerRadius: 26, style: .continuous))
+    }
+}
