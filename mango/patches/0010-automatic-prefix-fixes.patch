+// MARK: - Mango Port: automatic prefix fixes
+
+/// Fixes to Mango Port's Windows that games need and nobody should have to make by hand.
+/// Run at every app start and before every game start; each one is cheap and does nothing
+/// once it is in place. Not main-actor bound: LibraryModel.prepare calls it too.
+enum MangoPrefixFixes {
+    /// Steam's custom-executable step (CEG, in older Activision and 2K games such as Black Ops,
+    /// Black Ops II and Borderlands 2) waits forever on "Steam is preparing this game's
+    /// executable" unless the empty folders C:\windows\system32\mui and C:\windows\syswow64\mui
+    /// exist, as they do on Windows (Madeira's Black Ops notes; the help guide, section 6).
+    static func apply() {
+        let fm = FileManager.default
+        let windows = MadeiraDock.drive.appendingPathComponent("windows", isDirectory: true)
+        guard fm.fileExists(atPath: windows.path) else { return }   // no Windows yet: the first start makes it, the next one these
+        for sub in ["system32/mui", "syswow64/mui"] {
+            let dir = windows.appendingPathComponent(sub, isDirectory: true)
+            guard !fm.fileExists(atPath: dir.path) else { continue }
+            let name = "C:\\windows\\" + sub.replacingOccurrences(of: "/", with: "\\")
+            do {
+                try fm.createDirectory(at: dir, withIntermediateDirectories: true)
+                LogStore.shared.log("[mango-prefix] made \(name) (Steam's CEG step needs it)")
+            } catch {
+                LogStore.shared.log("[mango-prefix] could not make \(name): \(error.localizedDescription)")
+            }
+        }
+    }
+}
