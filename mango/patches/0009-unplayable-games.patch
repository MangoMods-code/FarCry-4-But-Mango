+
+// MARK: - Mango Port: games that cannot run
+
+/// Steam games tested in Mango Port and found unable to run on iPhone, by App ID, with
+/// the reason. They get a red label in the library, their Steam page offers no Install,
+/// and Play refuses to start them (LibraryDetail.start). Add a game here once a test
+/// shows it cannot run, for a reason no setting can change (kernel anti-cheat, for one).
+enum MangoUnplayable {
+    static let games: [Int: String] = [
+        // Easy Anti-Cheat stops at "Failed to initialize Wine helper buffer": its Wine
+        // support needs a Linux-only runtime (owner's test, 2026-11-12).
+        5155360: "Hood Warfare 2 uses Easy Anti-Cheat, which only runs on Windows and Linux. It can't start on iPhone.",
+    ]
+    static func reason(_ appID: Int?) -> String? { appID.flatMap { games[$0] } }
+}
+
+/// "Can't run on iPhone" in red.
+struct MangoUnplayableLabel: View {
+    var body: some View {
+        Label("Can't run on iPhone", systemImage: "xmark.octagon.fill")
+            .font(.system(.caption, design: .rounded).weight(.heavy))
+            .foregroundStyle(.red)
+            .lineLimit(1).minimumScaleFactor(0.8)
+    }
+}
+
+/// A grid card's artwork, dimmed with a red mark, for a game that cannot run.
+struct MangoUnplayableCover: View {
+    var body: some View {
+        ZStack {
+            Color.black.opacity(0.55)
+            Image(systemName: "xmark.octagon.fill").font(.system(size: 34, weight: .bold)).foregroundStyle(.red)
+        }
+        .clipShape(RoundedRectangle(cornerRadius: MangoTheme.cardRadius, style: .continuous))
+        .accessibilityHidden(true)
+    }
+}
