new file mode 100644
index 00000000..0d96bd0f
--- /dev/null
+++ b/app/Madeira/MangoCheat.inc.c
@@ -0,0 +1,387 @@
+/* Mango Port: Cheats, a memory scanner for single-player games.
+ *
+ * Every Windows program runs as a pseudo-process inside this one Mach task
+ * (docs/WOW64.md), so the game's numbers live in our own address space. This
+ * finds a number the way a desktop memory scanner does (scan, then narrow it
+ * with next scans while the number changes in the game), and sets or freezes
+ * it. Reads and writes go through mach_vm_read_overwrite / mach_vm_write, so a
+ * page that goes away mid-scan returns an error instead of crashing.
+ *
+ * What it scans: readable and writable regions with pages in memory, minus
+ * thread stacks, IOKit/graphics memory, the JIT pool (translated code and PE
+ * images) and its own buffers. Everything it keeps (results, old values,
+ * frozen values) lives in memory tagged MANGO_CHEAT_TAG, which the scan skips,
+ * so it never finds its own copies.
+ *
+ * Included at the end of JITAllocator.c (one file, no project change). The
+ * #ifndef MANGO_CHEAT_TEST part is the Mach layer; the test build in
+ * mango/tests supplies its own.
+ */
+
+#include <math.h>
+#include <stdatomic.h>
+
+#define MANGO_CHEAT_TAG 253            /* VM_MEMORY_APPLICATION_SPECIFIC_14 */
+#define MANGO_CHEAT_MAX (4u << 20)     /* results kept at most */
+#define MANGO_CHEAT_CHUNK (4u << 20)   /* bytes read at a time */
+#define MANGO_CHEAT_FREEZE_MAX 64
+
+/* Value kinds. 0 in a scan means "any number": float, double and int32 together. */
+enum { MC_ANY = 0, MC_I32 = 1, MC_F32 = 2, MC_F64 = 3, MC_I64 = 4 };
+/* Next scan modes. */
+enum { MC_EXACT = 0, MC_UP = 1, MC_DOWN = 2, MC_CHANGED = 3, MC_SAME = 4 };
+
+typedef struct { uint64_t addr; uint64_t old; } mc_hit;   /* addr: kind in the top byte */
+
+typedef struct {
+    uint64_t addr; uint32_t kind; uint32_t on; uint64_t bits;
+} mc_freeze;
+
+static mc_hit *mc_hits;            /* MANGO_CHEAT_MAX entries, tagged memory */
+static uint64_t mc_count;
+static int mc_truncated;
+static uint8_t *mc_buf;            /* one chunk, tagged memory */
+static mc_freeze *mc_frozen;       /* MANGO_CHEAT_FREEZE_MAX, tagged memory */
+static pthread_mutex_t mc_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_mutex_t mc_freeze_lock = PTHREAD_MUTEX_INITIALIZER;
+static _Atomic int mc_progress;    /* 0...1000 while a scan runs */
+static _Atomic int mc_cancel;
+static int mc_freeze_thread;
+
+static int mc_size(int kind) { return (kind == MC_F64 || kind == MC_I64) ? 8 : 4; }
+
+/* ---- platform layer -------------------------------------------------- */
+#ifndef MANGO_CHEAT_TEST
+
+extern kern_return_t mach_vm_read_overwrite(vm_map_t, mach_vm_address_t, mach_vm_size_t,
+                                            mach_vm_address_t, mach_vm_size_t *);
+extern kern_return_t mach_vm_write(vm_map_t, mach_vm_address_t, vm_offset_t, mach_msg_type_number_t);
+extern kern_return_t mach_vm_allocate(vm_map_t, mach_vm_address_t *, mach_vm_size_t, int);
+#include <dlfcn.h>
+
+static void *mc_alloc(size_t size)
+{
+    mach_vm_address_t a = 0;
+    if (mach_vm_allocate(mach_task_self(), &a, size, VM_FLAGS_ANYWHERE | VM_MAKE_TAG(MANGO_CHEAT_TAG)) != KERN_SUCCESS)
+        return NULL;
+    return (void *)(uintptr_t)a;
+}
+
+static int mc_read(uint64_t addr, void *out, size_t size)
+{
+    mach_vm_size_t got = 0;
+    return mach_vm_read_overwrite(mach_task_self(), addr, size, (mach_vm_address_t)(uintptr_t)out, &got) == KERN_SUCCESS
+        && got == size;
+}
+
+static int mc_write(uint64_t addr, const void *src, size_t size)
+{
+    return mach_vm_write(mach_task_self(), addr, (vm_offset_t)(uintptr_t)src, (mach_msg_type_number_t)size) == KERN_SUCCESS;
+}
+
+/* Ranges never scanned: the JIT pool's RW alias and its low part (code and
+ * PE images; virtual_ios.c skips the same ranges). Looked up by name, since
+ * the pool lives in Wine's unix side. */
+static int mc_excluded(uint64_t a, uint64_t size)
+{
+    static int looked;
+    static void **rw; static size_t *ps; static uintptr_t *low_rw; static size_t *low;
+    if (!looked) {
+        looked = 1;
+        rw = dlsym(RTLD_DEFAULT, "ios_jit_rw_base_global");
+        ps = dlsym(RTLD_DEFAULT, "ios_jit_pool_size_global");
+        low_rw = dlsym(RTLD_DEFAULT, "ios_jit_low_rw_global");
+        low = dlsym(RTLD_DEFAULT, "ios_jit_low_size_global");
+    }
+    if (rw && ps && *rw && *ps) {
+        uint64_t b = (uintptr_t)*rw;
+        if (a < b + *ps && a + size > b) return 1;
+        if (low_rw && low && *low && *low_rw && a < b && a + size > *low_rw) return 1;
+    }
+    return 0;
+}
+
+/* Calls back for every region worth scanning, in address order. */
+static void mc_regions(void (*fn)(uint64_t, uint64_t, void *), void *ctx, uint64_t *total)
+{
+    mach_vm_address_t a = 0;
+    *total = 0;
+    for (;;) {
+        mach_vm_size_t size = 0;
+        vm_region_extended_info_data_t info;
+        mach_msg_type_number_t cnt = VM_REGION_EXTENDED_INFO_COUNT;
+        mach_port_t obj = MACH_PORT_NULL;
+        if (mach_vm_region(mach_task_self(), &a, &size, VM_REGION_EXTENDED_INFO,
+                           (vm_region_info_t)&info, &cnt, &obj) != KERN_SUCCESS) break;
+        int tag = info.user_tag;
+        int ok = (info.protection & (VM_PROT_READ | VM_PROT_WRITE)) == (VM_PROT_READ | VM_PROT_WRITE)
+              && info.share_mode != SM_EMPTY
+              && (info.pages_resident + info.pages_swapped_out) > 0
+              && (tag == 0 || (tag >= 1 && tag <= 13) || (tag >= 240 && tag <= 252))
+              && !mc_excluded(a, size);
+        if (ok) {
+            if (fn) fn(a, size, ctx);
+            else *total += size;
+        }
+        a += size;
+    }
+}
+
+#endif /* MANGO_CHEAT_TEST */
+
+/* ---- matching -------------------------------------------------------- */
+
+/* A typed number matches what the game shows: "167.47" is 167.465 up to
+ * 167.48 (the game may round or cut the last digit); "167" is 166.5 up to 168. */
+typedef struct { double lo, hi; int64_t ival; int integral; } mc_want;
+
+static mc_want mc_target(double v, int decimals)
+{
+    mc_want w;
+    double unit = pow(10.0, -(decimals < 0 ? 0 : decimals > 6 ? 6 : decimals));
+    w.lo = v - unit / 2; w.hi = v + unit;
+    if (v < 0) { w.lo = v - unit; w.hi = v + unit / 2; }
+    w.integral = decimals <= 0 && v == floor(v) && fabs(v) < 9.2e18;
+    w.ival = w.integral ? (int64_t)v : 0;
+    return w;
+}
+
+static double mc_value(int kind, const void *p)
+{
+    switch (kind) {
+    case MC_I32: { int32_t x; memcpy(&x, p, 4); return x; }
+    case MC_F32: { float x; memcpy(&x, p, 4); return x; }
+    case MC_F64: { double x; memcpy(&x, p, 8); return x; }
+    case MC_I64: { int64_t x; memcpy(&x, p, 8); return (double)x; }
+    }
+    return 0;
+}
+
+static uint64_t mc_bits(int kind, const void *p)
+{
+    uint64_t b = 0; memcpy(&b, p, mc_size(kind)); return b;
+}
+
+static int mc_match(int kind, const void *p, const mc_want *w)
+{
+    if (kind == MC_I32) { int32_t x; memcpy(&x, p, 4); return w->integral && x == w->ival; }
+    if (kind == MC_I64) { int64_t x; memcpy(&x, p, 8); return w->integral && x == w->ival; }
+    double x = mc_value(kind, p);
+    /* Tiny denormals are random bits, not numbers a game shows. */
+    if (!isfinite(x) || (x != 0 && fabs(x) < 1e-6)) return 0;
+    return x >= w->lo && x < w->hi;
+}
+
+static int mc_ensure_buffers(void)
+{
+    if (!mc_buf) mc_buf = mc_alloc(MANGO_CHEAT_CHUNK + 8);
+    if (!mc_hits) mc_hits = mc_alloc((size_t)MANGO_CHEAT_MAX * sizeof(mc_hit));
+    if (!mc_frozen) mc_frozen = mc_alloc(MANGO_CHEAT_FREEZE_MAX * sizeof(mc_freeze));
+    return mc_buf && mc_hits && mc_frozen;
+}
+
+/* ---- first scan ------------------------------------------------------ */
+
+typedef struct { int kind; mc_want want; uint64_t done, total; } mc_first_ctx;
+
+static void mc_add(uint64_t addr, int kind, uint64_t bits)
+{
+    if (mc_count >= MANGO_CHEAT_MAX) { mc_truncated = 1; return; }
+    mc_hits[mc_count].addr = addr | ((uint64_t)kind << 56);
+    mc_hits[mc_count].old = bits;
+    mc_count++;
+}
+
+static void mc_first_region(uint64_t base, uint64_t size, void *vctx)
+{
+    mc_first_ctx *c = vctx;
+    for (uint64_t off = 0; off < size && !atomic_load(&mc_cancel); off += MANGO_CHEAT_CHUNK) {
+        uint64_t n = size - off < MANGO_CHEAT_CHUNK ? size - off : MANGO_CHEAT_CHUNK;
+        if (mc_read(base + off, mc_buf, n)) {
+            for (uint64_t i = 0; i + 4 <= n; i += 4) {
+                const uint8_t *p = mc_buf + i;
+                uint64_t addr = base + off + i;
+                if (c->kind == MC_ANY || c->kind == MC_I32) if (mc_match(MC_I32, p, &c->want)) mc_add(addr, MC_I32, mc_bits(MC_I32, p));
+                if (c->kind == MC_ANY || c->kind == MC_F32) if (mc_match(MC_F32, p, &c->want)) mc_add(addr, MC_F32, mc_bits(MC_F32, p));
+                if (i + 8 <= n) {
+                    if (c->kind == MC_ANY || c->kind == MC_F64) if (mc_match(MC_F64, p, &c->want)) mc_add(addr, MC_F64, mc_bits(MC_F64, p));
+                    if (c->kind == MC_I64) if (mc_match(MC_I64, p, &c->want)) mc_add(addr, MC_I64, mc_bits(MC_I64, p));
+                }
+            }
+        }
+        c->done += n;
+        if (c->total) atomic_store(&mc_progress, (int)(c->done * 1000 / c->total));
+    }
+}
+
+/* Returns the number of results, or -1 when the buffers cannot be made. */
+long mango_cheat_first_scan(int kind, double value, int decimals)
+{
+    pthread_mutex_lock(&mc_lock);
+    if (!mc_ensure_buffers()) { pthread_mutex_unlock(&mc_lock); return -1; }
+    mc_count = 0; mc_truncated = 0;
+    atomic_store(&mc_cancel, 0);
+    atomic_store(&mc_progress, 0);
+    mc_first_ctx c = { kind, mc_target(value, decimals), 0, 0 };
+    mc_regions(NULL, NULL, &c.total);
+    uint64_t dummy;
+    mc_regions(mc_first_region, &c, &dummy);
+    atomic_store(&mc_progress, 1000);
+    long n = (long)mc_count;
+    pthread_mutex_unlock(&mc_lock);
+    return n;
+}
+
+/* ---- next scan ------------------------------------------------------- */
+
+long mango_cheat_next_scan(int mode, double value, int decimals)
+{
+    pthread_mutex_lock(&mc_lock);
+    if (!mc_hits) { pthread_mutex_unlock(&mc_lock); return 0; }
+    atomic_store(&mc_cancel, 0);
+    mc_want w = mc_target(value, decimals);
+    uint64_t keep = 0;
+    uint8_t now[8];
+    for (uint64_t i = 0; i < mc_count; i++) {
+        if ((i & 0xfff) == 0) atomic_store(&mc_progress, (int)(i * 1000 / (mc_count ? mc_count : 1)));
+        int kind = (int)(mc_hits[i].addr >> 56);
+        uint64_t addr = mc_hits[i].addr & 0x00ffffffffffffffULL;
+        if (!mc_read(addr, now, mc_size(kind))) continue;
+        uint64_t bits = mc_bits(kind, now);
+        double a = mc_value(kind, &mc_hits[i].old), b = mc_value(kind, now);
+        int ok = 0;
+        switch (mode) {
+        case MC_EXACT: ok = mc_match(kind, now, &w); break;
+        case MC_UP: ok = b > a; break;
+        case MC_DOWN: ok = b < a; break;
+        case MC_CHANGED: ok = bits != mc_hits[i].old; break;
+        case MC_SAME: ok = bits == mc_hits[i].old; break;
+        }
+        if (ok) { mc_hits[keep].addr = mc_hits[i].addr; mc_hits[keep].old = bits; keep++; }
+    }
+    mc_count = keep;
+    atomic_store(&mc_progress, 1000);
+    pthread_mutex_unlock(&mc_lock);
+    return (long)keep;
+}
+
+/* ---- results, setting and freezing ----------------------------------- */
+
+long mango_cheat_count(void) { return (long)mc_count; }
+int mango_cheat_truncated(void) { return mc_truncated; }
+int mango_cheat_progress(void) { return atomic_load(&mc_progress); }
+void mango_cheat_cancel(void) { atomic_store(&mc_cancel, 1); }
+
+void mango_cheat_reset(void)
+{
+    pthread_mutex_lock(&mc_lock);
+    mc_count = 0; mc_truncated = 0;
+    pthread_mutex_unlock(&mc_lock);
+}
+
+/* Result i: its address, kind and current value. Returns 0 past the end or
+ * when the address cannot be read any more. */
+int mango_cheat_result(long i, uint64_t *addr, int *kind, double *value)
+{
+    uint8_t now[8];
+    if (i < 0 || (uint64_t)i >= mc_count) return 0;
+    int k = (int)(mc_hits[i].addr >> 56);
+    uint64_t a = mc_hits[i].addr & 0x00ffffffffffffffULL;
+    *addr = a; *kind = k;
+    if (!mc_read(a, now, mc_size(k))) return 0;
+    *value = mc_value(k, now);
+    return 1;
+}
+
+/* Any address's current value (kept numbers). Returns 0 when it cannot be read. */
+int mango_cheat_peek(uint64_t addr, int kind, double *value)
+{
+    uint8_t now[8];
+    if (kind < MC_I32 || kind > MC_I64 || !mc_read(addr, now, mc_size(kind))) return 0;
+    *value = mc_value(kind, now);
+    return 1;
+}
+
+/* The bits for value as kind, in tagged memory so the scan never finds them. */
+static void mc_encode(int kind, double v, uint64_t *out)
+{
+    *out = 0;
+    switch (kind) {
+    case MC_I32: { int32_t x = (int32_t)llround(v); memcpy(out, &x, 4); break; }
+    case MC_F32: { float x = (float)v; memcpy(out, &x, 4); break; }
+    case MC_F64: memcpy(out, &v, 8); break;
+    case MC_I64: { int64_t x = (int64_t)llround(v); memcpy(out, &x, 8); break; }
+    }
+}
+
+int mango_cheat_set(uint64_t addr, int kind, double value)
+{
+    if (!mc_ensure_buffers()) return 0;
+    uint64_t *bits = (uint64_t *)(mc_buf + MANGO_CHEAT_CHUNK);   /* tagged scratch */
+    pthread_mutex_lock(&mc_lock);
+    mc_encode(kind, value, bits);
+    int ok = mc_write(addr, bits, mc_size(kind));
+    pthread_mutex_unlock(&mc_lock);
+    return ok;
+}
+
+static void *mc_freeze_loop(void *unused)
+{
+    (void)unused;
+    for (;;) {
+        pthread_mutex_lock(&mc_freeze_lock);
+        for (int i = 0; i < MANGO_CHEAT_FREEZE_MAX; i++)
+            if (mc_frozen[i].on && !mc_write(mc_frozen[i].addr, &mc_frozen[i].bits, mc_size(mc_frozen[i].kind)))
+                mc_frozen[i].on = 0;   /* gone: the game freed it */
+        pthread_mutex_unlock(&mc_freeze_lock);
+        usleep(100 * 1000);
+    }
+    return NULL;
+}
+
+/* Freezes (on) or releases (off) addr at value. Returns 0 when the table is full. */
+int mango_cheat_freeze(uint64_t addr, int kind, double value, int on)
+{
+    if (!mc_ensure_buffers()) return 0;
+    int ok = !on;
+    pthread_mutex_lock(&mc_freeze_lock);
+    for (int i = 0; i < MANGO_CHEAT_FREEZE_MAX; i++)
+        if (mc_frozen[i].on && mc_frozen[i].addr == addr) mc_frozen[i].on = 0;
+    if (on) {
+        for (int i = 0; i < MANGO_CHEAT_FREEZE_MAX; i++)
+            if (!mc_frozen[i].on) {
+                mc_frozen[i].addr = addr; mc_frozen[i].kind = (uint32_t)kind;
+                mc_encode(kind, value, &mc_frozen[i].bits);
+                mc_frozen[i].on = 1; ok = 1;
+                break;
+            }
+        if (ok && !mc_freeze_thread) {
+            pthread_t t;
+            if (pthread_create(&t, NULL, mc_freeze_loop, NULL) == 0) { pthread_detach(t); mc_freeze_thread = 1; }
+        }
+    }
+    pthread_mutex_unlock(&mc_freeze_lock);
+    return ok;
+}
+
+int mango_cheat_is_frozen(uint64_t addr)
+{
+    if (!mc_frozen) return 0;
+    pthread_mutex_lock(&mc_freeze_lock);
+    int on = 0;
+    for (int i = 0; i < MANGO_CHEAT_FREEZE_MAX; i++)
+        if (mc_frozen[i].on && mc_frozen[i].addr == addr) on = 1;
+    pthread_mutex_unlock(&mc_freeze_lock);
+    return on;
+}
+
+/* Called when a session ends: nothing stays frozen into the next game. */
+void mango_cheat_end_session(void)
+{
+    if (mc_frozen) {
+        pthread_mutex_lock(&mc_freeze_lock);
+        for (int i = 0; i < MANGO_CHEAT_FREEZE_MAX; i++) mc_frozen[i].on = 0;
+        pthread_mutex_unlock(&mc_freeze_lock);
+    }
+    mango_cheat_reset();
+}
