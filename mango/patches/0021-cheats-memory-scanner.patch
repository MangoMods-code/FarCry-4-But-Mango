+// MARK: - Mango Port: Cheats
+
+/// Mango Port's memory scanner (MangoCheat.inc.c), driven from the Session menu.
+/// The game runs inside Mango Port's own memory, so a number the game shows
+/// (money, ammo, health) can be found, set and frozen while it runs, the way a
+/// desktop memory scanner does it. Kept for the app's life; a session's end
+/// clears the results and unfreezes everything.
+///
+/// Typed numbers stay text here and are turned into numbers only inside the
+/// scan (on its own thread's stack, which the scan skips), so the scan never
+/// finds Mango Port's own copy of the number.
+@MainActor
+final class MangoCheats: ObservableObject {
+    static let shared = MangoCheats()
+
+    struct Row: Identifiable { let id: Int; let address: UInt64; let kind: Int32; let text: String }
+    struct Saved: Identifiable { let id = UUID(); var name: String; let address: UInt64; let kind: Int32; var valueText: String }
+
+    static let kinds: [(Int32, String)] = [(0, "Any number"), (1, "Whole number"), (2, "Decimal (float)"), (3, "Decimal (double)"), (4, "Big whole number")]
+    static let modes: [(Int32, String)] = [(0, "Exact value"), (1, "Went up"), (2, "Went down"), (3, "Changed"), (4, "Didn't change")]
+
+    @Published var valueText = ""
+    @Published var kind: Int32 = 0
+    @Published var mode: Int32 = 0
+    @Published var scanning = false
+    @Published var progress = 0.0
+    @Published var count = 0
+    @Published var scanned = false
+    @Published var truncated = false
+    @Published var rows: [Row] = []
+    @Published var saved: [Saved] = []
+    @Published var setAllText = ""
+    @Published var note = ""
+
+    static let shownMax = 100
+
+    static func kindName(_ kind: Int32) -> String {
+        switch kind { case 1: return "int32"; case 2: return "float"; case 3: return "double"; case 4: return "int64"; default: return "?" }
+    }
+
+    static func format(_ value: Double, kind: Int32) -> String {
+        if kind == 1 || kind == 4 { return String(Int64(value)) }
+        return String(format: abs(value) >= 1e7 ? "%.0f" : "%.4f", value)
+            .replacingOccurrences(of: #"\.?0+$"#, with: "", options: .regularExpression)
+    }
+
+    /// "167.47" → 2 decimals; "1,250" → 1250. Nil when it isn't a number.
+    nonisolated static func parse(_ text: String) -> (Double, Int32)? {
+        let t = text.replacingOccurrences(of: ",", with: "").replacingOccurrences(of: "$", with: "")
+            .trimmingCharacters(in: .whitespaces)
+        guard let v = Double(t), v.isFinite else { return nil }
+        let decimals = t.split(separator: ".", omittingEmptySubsequences: false).dropFirst().first.map { Int32($0.count) } ?? 0
+        return (v, decimals)
+    }
+
+    var needsValue: Bool { !scanned || mode == 0 }
+    var canScan: Bool { !scanning && (!needsValue || Self.parse(valueText) != nil) }
+
+    func scan(first: Bool) {
+        guard canScan else { return }
+        scanning = true; progress = 0; note = ""
+        let text = valueText, kind = self.kind, mode = self.mode
+        let poll = Task { @MainActor in
+            while !Task.isCancelled { progress = Double(mango_cheat_progress()) / 1000; try? await Task.sleep(for: .milliseconds(150)) }
+        }
+        Task {
+            let n = await Task.detached(priority: .userInitiated) { () -> Int in
+                let parsed = MangoCheats.parse(text)
+                if first { return mango_cheat_first_scan(kind, parsed?.0 ?? 0, parsed?.1 ?? 0) }
+                return mango_cheat_next_scan(mode, parsed?.0 ?? 0, parsed?.1 ?? 0)
+            }.value
+            poll.cancel()
+            scanning = false
+            if n < 0 { note = "Mango Port couldn't reserve memory for the scan."; return }
+            scanned = true; count = n; truncated = mango_cheat_truncated() != 0
+            if first { self.mode = 0 }
+            if n == 0 { note = first ? "Nothing found. Check the number and the type, or try Any number." : "Nothing left. Start a new scan: the number may be stored differently (some games hide it)." }
+            refresh()
+            LogStore.shared.log("[cheats] \(first ? "scan" : "next scan") → \(n) results")
+        }
+    }
+
+    func reset() {
+        mango_cheat_reset(); scanned = false; count = 0; rows = []; truncated = false; note = ""; mode = 0
+    }
+
+    /// Reads the shown results' current values again.
+    func refresh() {
+        guard count > 0 && count <= Self.shownMax else { if !rows.isEmpty { rows = [] }; if !saved.isEmpty { objectWillChange.send() }; return }
+        var out: [Row] = []
+        for i in 0..<count {
+            var address: UInt64 = 0, kind: Int32 = 0, value = 0.0
+            if mango_cheat_result(i, &address, &kind, &value) != 0 {
+                out.append(Row(id: i, address: address, kind: kind, text: Self.format(value, kind: kind)))
+            }
+        }
+        rows = out
+        if !saved.isEmpty { objectWillChange.send() }   // the kept numbers' current values
+    }
+
+    /// A kept number's current value, or "gone" once the game freed it.
+    static func read(_ address: UInt64, kind: Int32) -> String {
+        var v = 0.0
+        guard mango_cheat_peek(address, kind, &v) != 0 else { return "gone" }
+        return format(v, kind: kind)
+    }
+
+    func save(_ row: Row) {
+        guard !saved.contains(where: { $0.address == row.address }) else { return }
+        saved.append(Saved(name: "Value \(saved.count + 1)", address: row.address, kind: row.kind, valueText: row.text))
+    }
+
+    @discardableResult
+    func set(_ address: UInt64, kind: Int32, text: String) -> Bool {
+        guard let (v, _) = Self.parse(text) else { note = "That isn't a number."; return false }
+        let ok = mango_cheat_set(address, kind, v) != 0
+        if mango_cheat_is_frozen(address) != 0 { _ = mango_cheat_freeze(address, kind, v, 1) }
+        note = ok ? "" : "The game freed that number. Scan again."
+        refresh()
+        return ok
+    }
+
+    func setAll() {
+        guard let (v, _) = Self.parse(setAllText) else { note = "That isn't a number."; return }
+        var done = 0
+        for row in rows where mango_cheat_set(row.address, row.kind, v) != 0 { done += 1 }
+        note = "Set \(done) of \(rows.count)."
+        refresh()
+    }
+
+    func freeze(_ item: Saved, on: Bool) {
+        guard let (v, _) = Self.parse(item.valueText) else { note = "That isn't a number."; return }
+        if mango_cheat_freeze(item.address, item.kind, v, on ? 1 : 0) == 0 { note = "Too many frozen numbers (64 at most)." }
+        objectWillChange.send()
+    }
+}
+
+/// The Session menu's Cheats page.
+struct MangoCheatsPage: View {
+    let back: () -> Void
+    let done: () -> Void
+    @ObservedObject private var cheats = MangoCheats.shared
+    private let tick = Timer.publish(every: 1, on: .main, in: .common).autoconnect()
+
+    var body: some View {
+        VStack(spacing: 0) {
+            HStack {
+                Button("Session", systemImage: "chevron.left", action: back).buttonStyle(.borderless)
+                Spacer()
+                Text("Cheats").font(.headline)
+                Spacer()
+                Button("Done", action: done).buttonStyle(.bordered)
+            }.padding(.horizontal, 22).padding(.top, 22).padding(.bottom, 8)
+            Form {
+                Section {
+                    TextField(cheats.needsValue ? "Number the game shows, e.g. 167.47" : "No number needed", text: $cheats.valueText)
+                        .keyboardType(.numbersAndPunctuation)
+                        .disabled(!cheats.needsValue)
+                    if !cheats.scanned {
+                        Picker("Type", selection: $cheats.kind) {
+                            ForEach(MangoCheats.kinds, id: \.0) { Text($0.1).tag($0.0) }
+                        }
+                    } else {
+                        Picker("Next scan", selection: $cheats.mode) {
+                            ForEach(MangoCheats.modes, id: \.0) { Text($0.1).tag($0.0) }
+                        }
+                    }
+                    if cheats.scanning {
+                        ProgressView(value: cheats.progress) { Text("Scanning…") }
+                    } else {
+                        HStack {
+                            Button(cheats.scanned ? "New scan" : "Scan") { cheats.scan(first: true) }
+                                .buttonStyle(.bordered).disabled(!cheats.canScan || (cheats.scanned && cheats.mode != 0 && MangoCheats.parse(cheats.valueText) == nil))
+                            if cheats.scanned {
+                                Button("Next scan") { cheats.scan(first: false) }
+                                    .buttonStyle(.borderedProminent).disabled(!cheats.canScan || cheats.count == 0)
+                                Spacer()
+                                Button("Clear", role: .destructive) { cheats.reset() }.buttonStyle(.borderless)
+                            }
+                        }
+                    }
+                    if cheats.scanned {
+                        Text(cheats.count == 1 ? "1 result" : "\(cheats.count.formatted()) results\(cheats.truncated ? " (the first ones only)" : "")")
+                            .font(.subheadline.monospacedDigit())
+                    }
+                    if !cheats.note.isEmpty { Text(cheats.note).font(.caption).foregroundStyle(.orange) }
+                } header: { Text("Find a number") } footer: {
+                    Text("Type the number the game shows and tap Scan. Then change it in the game (spend or earn some), type the new number and tap Next scan. Repeat until only a few results are left, and set them. Went up, Went down, Changed and Didn't change need no number.")
+                }
+
+                if cheats.scanned && cheats.count > MangoCheats.shownMax {
+                    Section { Text("Results show here once \(MangoCheats.shownMax) or fewer are left. Change the number in the game and use Next scan.").font(.caption).foregroundStyle(.secondary) }
+                }
+
+                if !cheats.rows.isEmpty {
+                    Section {
+                        ForEach(cheats.rows) { row in
+                            HStack {
+                                VStack(alignment: .leading, spacing: 2) {
+                                    Text(row.text).font(.body.monospacedDigit())
+                                    Text("\(MangoCheats.kindName(row.kind)) · 0x\(String(row.address, radix: 16))").font(.caption2.monospaced()).foregroundStyle(.secondary)
+                                }
+                                Spacer()
+                                Button("Keep", systemImage: "plus.circle") { cheats.save(row) }.labelStyle(.iconOnly).buttonStyle(.borderless)
+                            }
+                        }
+                        HStack {
+                            TextField("New value", text: $cheats.setAllText).keyboardType(.numbersAndPunctuation)
+                            Button("Set all") { cheats.setAll() }.buttonStyle(.bordered).disabled(MangoCheats.parse(cheats.setAllText) == nil)
+                        }
+                    } header: { Text("Results") } footer: {
+                        Text("A game often keeps the same number in more than one place: Set all changes every result. Keep (+) adds one to the list below, to set or freeze on its own.")
+                    }
+                }
+
+                if !cheats.saved.isEmpty {
+                    Section {
+                        ForEach($cheats.saved) { $item in
+                            VStack(alignment: .leading, spacing: 6) {
+                                HStack {
+                                    TextField("Name", text: $item.name).font(.subheadline.bold())
+                                    Text(MangoCheats.read(item.address, kind: item.kind)).font(.subheadline.monospacedDigit()).foregroundStyle(.secondary)
+                                }
+                                HStack {
+                                    TextField("Value", text: $item.valueText).keyboardType(.numbersAndPunctuation)
+                                    Button("Set") { cheats.set(item.address, kind: item.kind, text: item.valueText) }.buttonStyle(.bordered)
+                                    Toggle("Freeze", isOn: Binding(get: { mango_cheat_is_frozen(item.address) != 0 },
+                                                                   set: { cheats.freeze(item, on: $0) })).fixedSize()
+                                }
+                            }
+                        }
+                        .onDelete { set in
+                            for i in set { _ = mango_cheat_freeze(cheats.saved[i].address, cheats.saved[i].kind, 0, 0) }
+                            cheats.saved.remove(atOffsets: set)
+                        }
+                    } header: { Text("Kept numbers") } footer: {
+                        Text("Freeze writes the value again ten times a second, so the game can't change it. Nothing stays frozen after the game closes, and addresses change every launch, so scan again next time.")
+                    }
+                }
+
+                Section {
+                    Text("For single-player games. Mango Port doesn't run games with anti-cheat, and using cheats online can get an account banned. Setting a wrong result can crash the game: save first.")
+                        .font(.caption).foregroundStyle(.secondary)
+                }
+            }.scrollContentBackground(.hidden)
+        }
+        .onReceive(tick) { _ in if !cheats.scanning { cheats.refresh() } }
+    }
+}
