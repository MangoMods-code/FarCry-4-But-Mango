+// MARK: - Mango Port: uninstall from the library
+
+/// Uninstall from a game's card (long-press), confirmed once in the library (LibrarySheets).
+/// Apps installed in the same folder (Black Ops II and its Zombies and Multiplayer) go together:
+/// deleting the folder removes all of them, so none is left listed without its files.
+@MainActor final class MangoUninstall: ObservableObject {
+    static let shared = MangoUninstall()
+    @Published var asking: DockGame?
+
+    static func canUninstall(_ game: DockGame) -> Bool { SteamInstallPaths.isManaged(library: game.library) }
+
+    /// The other installed apps in this game's folder.
+    static func sharing(_ game: DockGame) -> [DockGame] {
+        SteamGamesModel.shared.games.filter {
+            $0.id != game.id && $0.library == game.library && $0.installDir.caseInsensitiveCompare(game.installDir) == .orderedSame
+        }
+    }
+
+    static func question(_ game: DockGame) -> String {
+        let others = sharing(game).map(\.name)
+        return others.isEmpty ? L("Its files are deleted, with its settings in Mango Port. You can download it again any time.")
+            : L("Its files are deleted, with its settings in Mango Port. These share its folder and are removed too:") + " " + others.joined(separator: ", ")
+    }
+
+    func run(_ game: DockGame) {
+        UINotificationFeedbackGenerator().notificationOccurred(.warning)
+        for each in [game] + Self.sharing(game) { SteamOwnedLibrary.shared.uninstall(each) }
+    }
+}
