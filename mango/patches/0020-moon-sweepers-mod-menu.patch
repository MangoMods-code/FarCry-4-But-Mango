+/// Game details › Mods (Moon Sweepers).
+struct MangoMoonModsPage: View {
+    @ObservedObject private var mods = MangoMoonMods.shared
+    @State private var readout: [String] = []
+    @State private var notice: String?
+    @State private var confirmCopy = false
+    @State private var moneyText = ""
+
+    var body: some View {
+        Form {
+            Section {
+                Toggle("Launch with mods", isOn: $mods.enabled).tint(MangoTheme.mango)
+                Picker("Modded save slot", selection: $mods.slot) {
+                    ForEach(1...4, id: \.self) { Text("Slot \($0)").tag($0) }
+                }
+                if mods.slot != 1 {
+                    Button("Copy slot 1 into slot \(mods.slot)…") { confirmCopy = true }
+                }
+            } footer: {
+                Text("Mods only change the slot picked here, and only when Launch with mods is on. Every other slot stays legit. Before each modded launch, the slot is backed up in Files › Mango Port › Mango Mod Backups. Play solo: keep mods out of co-op.")
+            }
+
+            Section {
+                ForEach(MangoMoonMods.upgrades, id: \.key) { upgrade in
+                    Picker(selection: Binding(get: { mods.levels[upgrade.key] ?? 0 },
+                                              set: { mods.levels[upgrade.key] = $0 == 0 ? nil : $0 })) {
+                        Text("Leave as is").tag(0)
+                        ForEach(1...10, id: \.self) { Text("Level \($0)").tag($0) }
+                    } label: {
+                        VStack(alignment: .leading, spacing: 2) {
+                            Text(upgrade.title)
+                            Text(upgrade.note).font(.caption).foregroundStyle(.secondary)
+                        }
+                    }
+                }
+            } header: { Text("Suit upgrades") } footer: {
+                Text("Only upgrades you've bought at least once can be changed. If a slot won't load after a big level, restore it below and pick a lower one.")
+            }
+
+            Section {
+                Toggle("Money changer (experimental)", isOn: $mods.moneyOn).tint(MangoTheme.mango)
+                if mods.moneyOn {
+                    LabeledContent("Money") {
+                        TextField("10000", text: $moneyText)
+                            .keyboardType(.decimalPad).multilineTextAlignment(.trailing)
+                            .onChange(of: moneyText) { _, text in if let value = Double(text) { mods.money = max(0, min(value, 1_000_000_000)) } }
+                    }
+                }
+            } header: { Text("Test mods") } footer: {
+                Text("The game scrambles its money, so this test sets your earnings total and the save-slot screen to the amount instead. It may not change the money shown in the game yet; tell Claude what you see.")
+            }
+
+            Section {
+                ForEach(readout, id: \.self) { Text($0).font(.callout) }
+                Button("Read slot \(mods.slot) again") { readout = mods.readout() }
+            } header: { Text("Slot \(mods.slot) now") }
+
+            Section {
+                if let last = mods.lastResult { Text(last).font(.caption).foregroundStyle(.secondary) }
+                Button("Restore slot \(mods.slot)'s last backup", role: .destructive) { notice = mods.restoreLatest(); readout = mods.readout() }
+            } header: { Text("Last modded launch") }
+
+            if let notice { Section { Text(notice).font(.callout) } }
+        }
+        .navigationTitle("Mods")
+        .onAppear {
+            readout = mods.readout()
+            moneyText = String(Int(mods.money))
+        }
+        .onChange(of: mods.slot) { _, _ in readout = mods.readout() }
+        .confirmationDialog("Copy slot 1 into slot \(mods.slot)?", isPresented: $confirmCopy, titleVisibility: .visible) {
+            Button("Copy", role: .destructive) { notice = mods.copySlotOne(); readout = mods.readout() }
+        } message: {
+            Text("Slot \(mods.slot)'s current save is backed up first, then replaced by a copy of slot 1. Slot 1 isn't changed.")
+        }
+    }
+}
