+/// The mods chosen on Moon Sweepers' Mods page, kept on this iPhone.
+final class MangoMoonMods: ObservableObject {
+    static let shared = MangoMoonMods()
+    struct Upgrade: Hashable { let key: String; let title: String; let note: String }
+    static let upgrades: [Upgrade] = [
+        Upgrade(key: "eco.payout", title: "Payout", note: "More money for each load of dust. Tested: works."),
+        Upgrade(key: "gear.belt", title: "Belt", note: "Carry capacity. Not tested yet."),
+        Upgrade(key: "suit.lamp", title: "Lamp", note: "Suit lamp. Not tested yet."),
+        Upgrade(key: "clean.width", title: "Clean width", note: "How wide a sweep cleans. Not tested yet."),
+    ]
+
+    @Published var enabled: Bool { didSet { save() } }
+    @Published var slot: Int { didSet { save() } }
+    /// Upgrade key -> level to set (missing: left as the game has it).
+    @Published var levels: [String: Int] { didSet { save() } }
+    @Published var moneyOn: Bool { didSet { save() } }
+    @Published var money: Double { didSet { save() } }
+    @Published private(set) var lastResult: String?
+
+    private static let key = "mango.moonMods"
+
+    init() {
+        let saved = UserDefaults.standard.dictionary(forKey: Self.key) ?? [:]
+        enabled = saved["enabled"] as? Bool ?? false
+        slot = saved["slot"] as? Int ?? 2
+        levels = saved["levels"] as? [String: Int] ?? [:]
+        moneyOn = saved["moneyOn"] as? Bool ?? false
+        money = saved["money"] as? Double ?? 10_000
+        lastResult = saved["lastResult"] as? String
+    }
+
+    private func save() {
+        var all: [String: Any] = ["enabled": enabled, "slot": slot, "levels": levels, "moneyOn": moneyOn, "money": money]
+        if let lastResult { all["lastResult"] = lastResult }
+        UserDefaults.standard.set(all, forKey: Self.key)
+    }
+
+    private func finish(_ text: String) {
+        lastResult = text
+        save()
+        LogStore.shared.log("[mango-mods] \(text)")
+    }
+
+    /// Where this slot's untouched copies go before each modded launch (outside the game's folder,
+    /// so Steam Cloud doesn't carry them): Documents/Mango Mod Backups/Moon Sweepers/slot-N/<time>.
+    static func backupRoot(_ slot: Int) -> URL {
+        LibraryModel.documents.appendingPathComponent("Mango Mod Backups/Moon Sweepers/slot-\(slot)", isDirectory: true)
+    }
+
+    private func backup(_ slotFolder: URL) throws -> URL {
+        let fm = FileManager.default
+        let stamp = ISO8601DateFormatter().string(from: Date()).replacingOccurrences(of: ":", with: "-")
+        let target = Self.backupRoot(slot).appendingPathComponent(stamp, isDirectory: true)
+        try fm.createDirectory(at: target.deletingLastPathComponent(), withIntermediateDirectories: true)
+        try fm.copyItem(at: slotFolder, to: target)
+        // Keep the newest five.
+        let all = ((try? fm.contentsOfDirectory(at: Self.backupRoot(slot), includingPropertiesForKeys: nil)) ?? []).sorted { $0.lastPathComponent > $1.lastPathComponent }
+        for old in all.dropFirst(5) { try? fm.removeItem(at: old) }
+        return target
+    }
+
+    /// Before Moon Sweepers starts (ContentView.launchLibraryEntry): with Launch with mods on, the chosen
+    /// slot gets the chosen mods. Any problem leaves the save as it was and the game starts anyway.
+    func beforeLaunch(_ entry: LibraryEntry) {
+        guard enabled, entry.steamAppID == MangoMoonSave.appID else { return }
+        do {
+            guard let folder = MangoMoonSave.slotFolder(slot) else {
+                throw MangoMoonSave.SaveError.notFound("Slot \(slot) has no save yet. Start a game in slot \(slot), or copy slot 1 into it, then try again.")
+            }
+            guard let file = MangoMoonSave.sessionFile(in: folder) else { throw MangoMoonSave.SaveError.notFound("Slot \(slot) has no session.moon.") }
+            var session = try MangoMoonSave.read(file)
+            var done: [String] = []
+            for (key, level) in levels.sorted(by: { $0.key < $1.key }) where level > 0 {
+                if MangoMoonSave.setLevel(key, level, in: &session.raw) { done.append("\(key) \(level)") }
+                else { done.append("\(key) not bought yet, skipped") }
+            }
+            if moneyOn {
+                let current = MangoMoonSave.slotDollars(folder) ?? 0
+                let spots = MangoMoonSave.earnings(in: session.raw)
+                for spot in spots {
+                    let earned = MangoMoonSave.double(at: spot, in: session.raw)
+                    MangoMoonSave.setDouble(earned + (money - current), at: spot, in: &session.raw)
+                }
+                done.append("money test \(Int(money)) (\(spots.count) spot\(spots.count == 1 ? "" : "s"))")
+            }
+            guard !done.isEmpty else { finish("Launch with mods is on, but no mod is chosen."); return }
+            let saved = try backup(folder)
+            try MangoMoonSave.write(session, to: file)
+            if moneyOn { MangoMoonSave.setSlotDollars(money, folder) }
+            finish("Slot \(slot): " + done.joined(separator: ", ") + ". Backup: \(saved.lastPathComponent)")
+        } catch {
+            finish("Mods not applied: \(error.localizedDescription)")
+        }
+    }
+
+    /// Copies slot 1 over the chosen slot (that slot's old files are backed up first).
+    func copySlotOne() -> String {
+        let fm = FileManager.default
+        guard slot != 1, let one = MangoMoonSave.slotFolder(1) else { return "Slot 1 has no save to copy." }
+        let target = one.deletingLastPathComponent().appendingPathComponent("slot-\(slot)", isDirectory: true)
+        do {
+            if fm.fileExists(atPath: target.path) {
+                _ = try backup(target)
+                try fm.removeItem(at: target)
+            }
+            try fm.copyItem(at: one, to: target)
+            finish("Copied slot 1 into slot \(slot).")
+            return "Slot 1 is now copied into slot \(slot). Pick slot \(slot) in the game for modded play."
+        } catch {
+            return "Couldn't copy: \(error.localizedDescription)"
+        }
+    }
+
+    /// Puts the newest backup of the chosen slot back.
+    func restoreLatest() -> String {
+        let fm = FileManager.default
+        guard let newest = ((try? fm.contentsOfDirectory(at: Self.backupRoot(slot), includingPropertiesForKeys: nil)) ?? [])
+            .sorted(by: { $0.lastPathComponent > $1.lastPathComponent }).first,
+              let target = MangoMoonSave.slotFolder(slot) ?? MangoMoonSave.slotFolder(1).map({ $0.deletingLastPathComponent().appendingPathComponent("slot-\(slot)") })
+        else { return "No backup of slot \(slot) yet." }
+        do {
+            if fm.fileExists(atPath: target.path) { try fm.removeItem(at: target) }
+            try fm.copyItem(at: newest, to: target)
+            finish("Restored slot \(slot) from \(newest.lastPathComponent).")
+            return "Slot \(slot) is back to how it was before \(newest.lastPathComponent)."
+        } catch {
+            return "Couldn't restore: \(error.localizedDescription)"
+        }
+    }
+
+    /// What the chosen slot holds now, for the page.
+    func readout() -> [String] {
+        guard let folder = MangoMoonSave.slotFolder(slot) else { return ["Slot \(slot): no save yet"] }
+        var lines: [String] = []
+        if let dollars = MangoMoonSave.slotDollars(folder) { lines.append(String(format: "Money: $%.2f", dollars)) }
+        if let file = MangoMoonSave.sessionFile(in: folder), let session = try? MangoMoonSave.read(file) {
+            for upgrade in Self.upgrades {
+                lines.append("\(upgrade.title): " + (MangoMoonSave.level(upgrade.key, in: session.raw).map { "level \($0)" } ?? "not bought"))
+            }
+        } else {
+            lines.append("The slot's save couldn't be read.")
+        }
+        return lines
+    }
+}
