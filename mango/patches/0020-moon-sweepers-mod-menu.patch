+// MARK: - Mango Port: Moon Sweepers mod menu
+
+/// Moon Sweepers' save files, read and written the way the game does. A slot's session.moon is
+/// "1PCM", the uncompressed length (UInt32), a 64-character SHA-256 of the uncompressed data
+/// (length-prefixed) and the data gzipped; slot.json beside it is the save-slot summary.
+enum MangoMoonSave {
+    static let appID = 5335510
+
+    struct Session {
+        var raw: Data
+        let magic: Data
+    }
+
+    enum SaveError: LocalizedError {
+        case notFound(String), badFile(String)
+        var errorDescription: String? {
+            switch self {
+            case .notFound(let what): return what
+            case .badFile(let what): return "This save isn't in the format Mango Port knows (\(what)). Nothing was changed."
+            }
+        }
+    }
+
+    /// The game's save folder: C:\users\<you>\AppData\LocalLow\DragDropGames\MoonSweepers.
+    static func root() -> URL? {
+        let users = MadeiraDock.drive.appendingPathComponent("users", isDirectory: true)
+        let names = (try? FileManager.default.contentsOfDirectory(atPath: users.path)) ?? []
+        for name in names {
+            let folder = users.appendingPathComponent(name).appendingPathComponent("AppData/LocalLow/DragDropGames/MoonSweepers", isDirectory: true)
+            if FileManager.default.fileExists(atPath: folder.path) { return folder }
+        }
+        return nil
+    }
+
+    /// A slot's folder ("slot-2"), wherever the game keeps it under its save folder.
+    static func slotFolder(_ slot: Int) -> URL? {
+        guard let root = root() else { return nil }
+        let want = "slot-\(slot)"
+        if let walker = FileManager.default.enumerator(at: root, includingPropertiesForKeys: [.isDirectoryKey]) {
+            for case let url as URL in walker where url.lastPathComponent == want {
+                if (try? url.resourceValues(forKeys: [.isDirectoryKey]))?.isDirectory == true { return url }
+            }
+        }
+        return nil
+    }
+
+    /// The slot's session.moon (inside its world folder).
+    static func sessionFile(in slotFolder: URL) -> URL? {
+        guard let walker = FileManager.default.enumerator(at: slotFolder, includingPropertiesForKeys: nil) else { return nil }
+        for case let url as URL in walker where url.lastPathComponent == "session.moon" && url.deletingLastPathComponent().lastPathComponent != "backups" {
+            return url
+        }
+        return nil
+    }
+
+    static func read(_ url: URL) throws -> Session {
+        let file = try Data(contentsOf: url)
+        guard file.count > 83, file.prefix(4) == Data("1PCM".utf8), file[file.startIndex + 8] == 64 else { throw SaveError.badFile("header") }
+        let bytes = [UInt8](file)
+        let length = Int(UInt32(bytes[4]) | UInt32(bytes[5]) << 8 | UInt32(bytes[6]) << 16 | UInt32(bytes[7]) << 24)
+        let hash = String(decoding: bytes[9..<73], as: UTF8.self)
+        guard length > 0, length < 64 << 20 else { throw SaveError.badFile("size") }
+        let raw = try gunzip(Array(bytes[73...]), length: length)
+        guard sha256Hex(raw) == hash else { throw SaveError.badFile("checksum") }
+        return Session(raw: Data(raw), magic: file.prefix(4))
+    }
+
+    static func write(_ session: Session, to url: URL) throws {
+        let raw = [UInt8](session.raw)
+        var out = Data(session.magic)
+        var length = UInt32(raw.count).littleEndian
+        withUnsafeBytes(of: &length) { out.append(contentsOf: $0) }
+        out.append(64)
+        out.append(Data(sha256Hex(raw).utf8))
+        out.append(try gzip(raw))
+        // Read back before replacing the real file: a bad write never reaches the game.
+        let check = url.deletingLastPathComponent().appendingPathComponent(".mango-check.moon")
+        try out.write(to: check, options: .atomic)
+        defer { try? FileManager.default.removeItem(at: check) }
+        _ = try read(check)
+        try out.write(to: url, options: .atomic)
+    }
+
+    static func sha256Hex(_ bytes: [UInt8]) -> String {
+        SHA256.hash(data: Data(bytes)).map { String(format: "%02x", $0) }.joined()
+    }
+
+    private static func gunzip(_ bytes: [UInt8], length: Int) throws -> [UInt8] {
+        guard bytes.count > 18, bytes[0] == 0x1f, bytes[1] == 0x8b, bytes[2] == 8 else { throw SaveError.badFile("compression") }
+        let flags = bytes[3]
+        var p = 10
+        if flags & 4 != 0 { p += 2 + Int(bytes[p]) + Int(bytes[p + 1]) << 8 }
+        if flags & 8 != 0 { while p < bytes.count, bytes[p] != 0 { p += 1 }; p += 1 }
+        if flags & 16 != 0 { while p < bytes.count, bytes[p] != 0 { p += 1 }; p += 1 }
+        if flags & 2 != 0 { p += 2 }
+        guard p < bytes.count - 8 else { throw SaveError.badFile("compression") }
+        var out = [UInt8](repeating: 0, count: length)
+        let deflated = Array(bytes[p..<(bytes.count - 8)])
+        let written = out.withUnsafeMutableBufferPointer { dst in
+            deflated.withUnsafeBufferPointer { src in
+                compression_decode_buffer(dst.baseAddress!, length, src.baseAddress!, deflated.count, nil, COMPRESSION_ZLIB)
+            }
+        }
+        guard written == length else { throw SaveError.badFile("compressed data") }
+        return out
+    }
+
+    private static func gzip(_ raw: [UInt8]) throws -> Data {
+        let capacity = raw.count + raw.count / 8 + 4096
+        var deflated = [UInt8](repeating: 0, count: capacity)
+        let written = deflated.withUnsafeMutableBufferPointer { dst in
+            raw.withUnsafeBufferPointer { src in
+                compression_encode_buffer(dst.baseAddress!, capacity, src.baseAddress!, raw.count, nil, COMPRESSION_ZLIB)
+            }
+        }
+        guard written > 0 else { throw SaveError.badFile("compressing") }
+        var out = Data([0x1f, 0x8b, 8, 0, 0, 0, 0, 0, 0, 0x0a])
+        out.append(contentsOf: deflated[0..<written])
+        var crc = crc32(raw).littleEndian, size = UInt32(truncatingIfNeeded: raw.count).littleEndian
+        withUnsafeBytes(of: &crc) { out.append(contentsOf: $0) }
+        withUnsafeBytes(of: &size) { out.append(contentsOf: $0) }
+        return out
+    }
+
+    private static let crcTable: [UInt32] = (0..<256).map { index -> UInt32 in
+        var c = UInt32(index)
+        for _ in 0..<8 { c = (c & 1) != 0 ? 0xEDB8_8320 ^ (c >> 1) : c >> 1 }
+        return c
+    }
+    private static func crc32(_ bytes: [UInt8]) -> UInt32 {
+        var c: UInt32 = 0xFFFF_FFFF
+        for byte in bytes { c = crcTable[Int((c ^ UInt32(byte)) & 0xFF)] ^ (c >> 8) }
+        return c ^ 0xFFFF_FFFF
+    }
+
+    // MARK: Values inside a session
+
+    /// An upgrade's level: its name (length-prefixed) followed by an Int32.
+    static func level(_ name: String, in raw: Data) -> Int? {
+        guard let at = position(after: name, in: raw), at + 4 <= raw.count else { return nil }
+        return Int(raw.withUnsafeBytes { $0.loadUnaligned(fromByteOffset: at, as: Int32.self) }.littleEndian)
+    }
+
+    static func setLevel(_ name: String, _ value: Int, in raw: inout Data) -> Bool {
+        guard let at = position(after: name, in: raw), at + 4 <= raw.count else { return false }
+        var v = Int32(value).littleEndian
+        withUnsafeBytes(of: &v) { raw.replaceSubrange(at..<(at + 4), with: $0) }
+        return true
+    }
+
+    private static func position(after name: String, in raw: Data) -> Int? {
+        var needle = Data([UInt8(name.utf8.count)])
+        needle.append(Data(name.utf8))
+        guard let range = raw.range(of: needle) else { return nil }
+        return range.upperBound - raw.startIndex
+    }
+
+    /// Lifetime earnings, stored as a Double right before the team's name ("<earned> 01000000 04 team"),
+    /// with a second copy in the player's entry just before it.
+    static func earnings(in raw: Data) -> [Int] {
+        guard let team = raw.range(of: Data([4] + Array("team".utf8))) else { return [] }
+        let t = team.lowerBound - raw.startIndex
+        var spots: [Int] = []
+        if t >= 12 { spots.append(t - 12) }
+        if t >= 24, raw.subdata(in: (t - 24)..<(t - 16)) == raw.subdata(in: (t - 12)..<(t - 4)) { spots.append(t - 24) }
+        return spots
+    }
+
+    static func double(at offset: Int, in raw: Data) -> Double {
+        Double(bitPattern: raw.withUnsafeBytes { $0.loadUnaligned(fromByteOffset: offset, as: UInt64.self) }.littleEndian)
+    }
+
+    static func setDouble(_ value: Double, at offset: Int, in raw: inout Data) {
+        var bits = value.bitPattern.littleEndian
+        withUnsafeBytes(of: &bits) { raw.replaceSubrange(offset..<(offset + 8), with: $0) }
+    }
+
+    /// slot.json's money (the save-slot screen).
+    static func slotDollars(_ slotFolder: URL) -> Double? {
+        guard let data = try? Data(contentsOf: slotFolder.appendingPathComponent("slot.json")),
+              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return nil }
+        return (object["dollars"] as? NSNumber)?.doubleValue
+    }
+
+    static func setSlotDollars(_ value: Double, _ slotFolder: URL) {
+        for name in ["slot.json", "slot.json.bak"] {
+            let url = slotFolder.appendingPathComponent(name)
+            guard let text = try? String(contentsOf: url, encoding: .utf8),
+                  let regex = try? NSRegularExpression(pattern: "\"dollars\":[-0-9.eE+]+") else { continue }
+            let range = NSRange(text.startIndex..., in: text)
+            let replaced = regex.stringByReplacingMatches(in: text, range: range, withTemplate: "\"dollars\":\(value)")
+            try? replaced.write(to: url, atomically: true, encoding: .utf8)
+        }
+    }
+}
