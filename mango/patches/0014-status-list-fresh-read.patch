+    /// The list as GitHub has it now: the contents API answers from the repository itself
+    /// (the owner's token when there is one, for the higher limit); without an answer from it
+    /// (no connection to it, or the hourly limit for this network), the raw CDN copy.
+    /// `fresh` is false for the CDN copy.
+    private static func fetch() async throws -> ([Game], Bool) {
+        var api = URLRequest(url: apiURL, cachePolicy: .reloadIgnoringLocalCacheData, timeoutInterval: 15)
+        if let token = MangoOwnerKey.read() { authorize(&api, token) } else {
+            api.setValue("2022-11-28", forHTTPHeaderField: "X-GitHub-Api-Version")
+            api.setValue("MangoPort", forHTTPHeaderField: "User-Agent")
+        }
+        api.setValue("application/vnd.github.raw+json", forHTTPHeaderField: "Accept")
+        if let answer = try? await URLSession.shared.data(for: api),
