+// MARK: - Mango Port: game modes as add-ons
+
+/// Games whose modes Steam sells as apps of their own, by the main game's App ID. In the
+/// library a mode is an add-on of its main game (SteamGamesRules.items) instead of a card of
+/// its own; the main game's page and download sheet list it with a switch (MangoAddOnsSection).
+enum MangoGameFamily {
+    struct Mode: Hashable { let appID: Int; let name: String }
+    static let modes: [Int: [Mode]] = [
+        202970: [Mode(appID: 212910, name: "Zombies"), Mode(appID: 202990, name: "Multiplayer")],   // Call of Duty: Black Ops II
+        42700: [Mode(appID: 42710, name: "Multiplayer")],     // Call of Duty: Black Ops
+        10180: [Mode(appID: 10190, name: "Multiplayer")],     // Call of Duty: Modern Warfare 2 (2009)
+        115300: [Mode(appID: 42690, name: "Multiplayer")],    // Call of Duty: Modern Warfare 3 (2011)
+    ]
+    static let parentOf: [Int: Int] = {
+        var map: [Int: Int] = [:]
+        for (parent, list) in modes { for mode in list { map[mode.appID] = parent } }
+        return map
+    }()
+    /// A mode's card is left out when its main game is in the library too, unless the mode is
+    /// installed and its main game is not (then the mode's card is the only way to play it).
+    static func hidesCard(_ appID: Int, mode: SteamGamesRules.Item?, parent: SteamGamesRules.Item?) -> Bool {
+        guard parentOf[appID] != nil, let mode, let parent else { return false }
+        return mode.installed == nil || parent.installed != nil
+    }
+}
+
+/// Opens a mode's Game details page from its main game's page: the library swaps the page it
+/// shows (LibrarySheets).
+@MainActor final class MangoAddOnRouter: ObservableObject {
+    static let shared = MangoAddOnRouter()
+    @Published var open: LibraryEntry?
+}
+
+/// A game's modes, each with a switch: on downloads it (with the game's Steam download queue),
+/// off removes it. A mode that shares its install folder with another installed app (Black Ops
+/// II's modes install into the main game's folder) is not deleted: removing its folder would
+/// remove the main game too.
+struct MangoAddOnsSection: View {
+    let appID: Int
+    /// The Game details page shows Open for an installed mode; the download sheet does not.
+    var opens: Bool
+    @ObservedObject private var steam = SteamOwnedLibrary.shared
+    @ObservedObject private var games = SteamGamesModel.shared
+    @State private var removing: DockGame?
+    @State private var shared: MangoGameFamily.Mode?
+
+    var body: some View {
+        let list = MangoGameFamily.modes[appID] ?? []
+        Section {
+            ForEach(list, id: \.appID) { mode in row(mode) }
+        } header: {
+            Text("Add-ons")
+        } footer: {
+            Text("These modes are separate apps on Steam. Switch one on to download it, or off to remove it.")
+        }
+        .confirmationDialog(removing.map { "Remove \($0.name)?" } ?? "", isPresented: Binding(get: { removing != nil }, set: { if !$0 { removing = nil } }),
+                            titleVisibility: .visible) {
+            Button("Remove", role: .destructive) { if let game = removing { steam.uninstall(game) }; removing = nil }
+        } message: { Text("Its files are deleted. You can download it again any time.") }
+        .alert("This mode can't be removed on its own", isPresented: Binding(get: { shared != nil }, set: { if !$0 { shared = nil } })) {
+            Button("OK", role: .cancel) { shared = nil }
+        } message: {
+            Text("\(shared?.name ?? "This mode") is installed in the same folder as the main game, so deleting it would delete the main game too. Uninstall the whole game from its Steam page to free the space.")
+        }
+    }
+
+    @ViewBuilder private func row(_ mode: MangoGameFamily.Mode) -> some View {
+        let installed = games.games.first { $0.id == mode.appID }
+        let download = steam.downloads[mode.appID]
+        let owned = steam.game(mode.appID) != nil
+        let downloading: Bool = {
+            guard let download else { return false }
+            switch download.state { case .active, .queued: return true; case .paused, .failed: return false }
+        }()
+        let on = installed?.installed == true || downloading
+        VStack(alignment: .leading, spacing: 6) {
+            Toggle(isOn: Binding(get: { on }, set: { switchTo($0, mode, installed: installed, downloading: downloading) })) {
+                VStack(alignment: .leading, spacing: 2) {
+                    HStack(spacing: 6) {
+                        Text(mode.name).font(.system(.body, design: .rounded).weight(.heavy))
+                        if let tested = MangoCompat.entry(mode.appID) { MangoCompatLabel(status: tested.status) }
+                    }
+                    Text(caption(installed: installed, download: download, owned: owned)).font(.caption).foregroundStyle(.secondary)
+                }
+            }
+            .tint(MangoTheme.mango)
+            .disabled(!owned && installed == nil && download == nil)
+            if let download { SteamDownloadStatus(download: download) }
+            if opens, let installed, installed.installed, download == nil {
+                Button {
+                    MangoAddOnRouter.shared.open = LibraryModel.shared.steamEntry(installed, title: steam.game(mode.appID)?.name ?? installed.name)
+                } label: { Label("Open \(mode.name)", systemImage: "play.circle.fill") }
+                    .font(.subheadline.weight(.semibold))
+            }
+        }
+        .padding(.vertical, 2)
+    }
+
+    private func caption(installed: DockGame?, download: SteamOwnedLibrary.Download?, owned: Bool) -> String {
+        if let download {
+            switch download.state {
+            case .active: return L("Downloading")
+            case .queued: return L("Waiting to download")
+            case .paused: return L("Paused — switch on to resume")
+            case .failed: return L("Download stopped — switch on to try again")
+            }
+        }
+        if let installed { return installed.installed ? L("Downloaded") : L("Partly downloaded — switch on to finish") }
+        return owned ? L("Not downloaded") : L("Not in your Steam library")
+    }
+
+    private func switchTo(_ on: Bool, _ mode: MangoGameFamily.Mode, installed: DockGame?, downloading: Bool) {
+        UIImpactFeedbackGenerator(style: .light).impactOccurred()
+        if on { steam.install(mode.appID); return }
+        if downloading { steam.pause(mode.appID); return }
+        guard let installed else { return }
+        let sharesFolder = games.games.contains {
+            $0.id != installed.id && $0.library == installed.library && $0.installDir.caseInsensitiveCompare(installed.installDir) == .orderedSame
+        }
+        if sharesFolder { shared = mode } else { removing = installed }
+    }
 }
